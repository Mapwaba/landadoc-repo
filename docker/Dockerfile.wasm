# Shared build for the 3 Blazor WebAssembly frontends (Patient, Doctor, Admin).
# Standalone WASM apps are served as plain static files by nginx.
#
# Build arg:
#   PROJECT_PATH  e.g. src/Frontend/Patient/LandaDoc.Patient.csproj

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG PROJECT_PATH
WORKDIR /src
COPY . .
RUN dotnet publish "$PROJECT_PATH" -c Release -o /app

FROM nginx:alpine AS final
COPY docker/nginx-wasm.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/wwwroot /usr/share/nginx/html
