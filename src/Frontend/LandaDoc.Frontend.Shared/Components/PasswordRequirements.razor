@using LandaDoc.Shared.Security
@* The password rules (LandaDoc.Shared.Security.PasswordPolicy) as a checklist that ticks itself
   while the password is typed. The Identity service checks the same rules, so what's ticked here
   is exactly what the server accepts. *@
<ul class="ld-pw-rules">
    @foreach (var rule in PasswordPolicy.AllRules)
    {
        var met = Password.Length > 0 && !_failed.Contains(rule);
        <li class="@(met ? "met" : "")">
            <MudIcon Icon="@(met ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" Style="font-size:15px;" />
            @Lang[$"pwRule.{rule}"]
        </li>
    }
</ul>

@code {
    [Inject] private ILanguageService Lang { get; set; } = default!;

    [Parameter] public string Password { get; set; } = "";
    // First name, last name, email and any other names the password mustn't contain
    [Parameter] public string?[] PersonalData { get; set; } = [];

    private IReadOnlyList<PasswordRule> _failed = [];

    protected override void OnParametersSet() => _failed = PasswordPolicy.Check(Password ?? "", PersonalData);
}
