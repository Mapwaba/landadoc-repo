@page "/appointments"
@attribute [Authorize]

<PageTitle>My appointments</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Lang["My appointments"]</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_appointments.Count == 0)
{
    <MudAlert Severity="Severity.Info">@Lang["You have no appointments yet."] <MudLink Href="/doctors">@Lang["Find a doctor"]</MudLink> @Lang["to book one."]</MudAlert>
}
else
{
    <MudTable Items="_appointments" Hover="true">
        <HeaderContent>
            <MudTh>@Lang["Doctor"]</MudTh>
            <MudTh>@Lang["Date"]</MudTh>
            <MudTh>@Lang["Motif"]</MudTh>
            <MudTh>@Lang["Status"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@DoctorName(context.DoctorId)</MudTd>
            <MudTd>@context.SlotStart.ToString("g")</MudTd>
            <MudTd>@(context.Motif ?? "—")</MudTd>
            <MudTd><MudChip T="string" Color="@StatusColor(context.Status)">@Lang[$"status.{context.Status}"]</MudChip></MudTd>
            <MudTd><MudButton Href="@($"/appointments/{context.Id}")" Size="Size.Small">@Lang["View"]</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private ISearchApiClient SearchApi { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private bool _loading = true;
    private List<AppointmentDto> _appointments = [];
    private Dictionary<Guid, string> _doctorNames = [];

    protected override async Task OnInitializedAsync()
    {
        _appointments = await AppointmentsApi.GetMineAsync();

        var uniqueDoctorIds = _appointments.Select(a => a.DoctorId).Distinct().ToList();
        var resolved = await Task.WhenAll(uniqueDoctorIds.Select(async id =>
        {
            var doctor = await SearchApi.GetDoctorAsync(id);
            return (id, name: doctor is null ? Lang["Unknown doctor"] : $"{Lang["Dr."]} {doctor.FirstName} {doctor.LastName}");
        }));
        _doctorNames = resolved.ToDictionary(x => x.id, x => x.name);

        _loading = false;
    }

    private string DoctorName(Guid doctorId) => _doctorNames.GetValueOrDefault(doctorId, "—");

    private static Color StatusColor(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Completed => Color.Success,
        AppointmentStatus.Cancelled => Color.Error,
        AppointmentStatus.Confirmed => Color.Info,
        _ => Color.Default
    };
}
