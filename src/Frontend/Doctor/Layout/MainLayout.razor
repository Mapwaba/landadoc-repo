@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-2">@Lang["LandaDoc for Doctors"]</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudBadge Content="@Hub.PendingCount" Color="Color.Error" Overlap="true" Visible="@(Hub.PendingCount > 0)" Class="mx-2">
                    <MudButton Href="/appointments" Color="Color.Inherit">@Lang["Appointments"]</MudButton>
                </MudBadge>
                <MudButton Href="/schedule" Color="Color.Inherit">@Lang["Schedule"]</MudButton>
                <MudButton Href="/profile" Color="Color.Inherit">@Lang["Profile"]</MudButton>
                <MudButton Href="/reviews" Color="Color.Inherit">@Lang["Reviews"]</MudButton>
                <MudButton Href="/notifications" Color="Color.Inherit">@Lang["Notifications"]</MudButton>
                <MudButton OnClick="Logout" Color="Color.Inherit">@Lang["Log out"]</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Color="Color.Inherit">@Lang["Log in"]</MudButton>
                <MudButton Href="/register" Color="Color.Inherit">@Lang["Register"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
        <LanguageSwitcher />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private JwtAuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;
    [Inject] private NotificationHubService Hub { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Hub.PendingCountChanged += OnPendingCountChanged;
        await Hub.InitializeAsync();
    }

    private void OnPendingCountChanged(int count) => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await AuthState.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Hub.PendingCountChanged -= OnPendingCountChanged;
}
