@inherits LayoutComponentBase
@implements IDisposable
@using LandaDoc.Doctor.Services

<MudThemeProvider Theme="LandaDocTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AppShell Subtitle="@Lang["Doctor space"]" NotificationsHref="/notifications" NotificationDot="@_newNotification">
    <NavItems>
        <ShellNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" Text="@Lang["Dashboard"]" />
        <ShellNavLink Href="/appointments" Icon="@Icons.Material.Outlined.CalendarMonth" Text="@Lang["Appointments"]" Badge="@Hub.PendingCount" />
        <ShellNavLink Href="/schedule" Icon="@Icons.Material.Outlined.Schedule" Text="@Lang["Schedule"]" />
        <ShellNavLink Href="/patients" Icon="@Icons.Material.Outlined.People" Text="@Lang["Patients"]" />
        <ShellNavLink Href="/payments" Icon="@Icons.Material.Outlined.AttachMoney" Text="@Lang["Payments"]" />
        <ShellNavLink Href="/workplace" Icon="@Icons.Material.Outlined.Apartment" Text="@Lang["My workplace"]" />
        <ShellNavLink Href="/documents" Icon="@Icons.Material.Outlined.Description" Text="@Lang["Documents"]" />
        <ShellNavLink Href="/services" Icon="@Icons.Material.Outlined.MedicalServices" Text="@Lang["Services & acts"]" />
        <ShellNavLink Href="/reviews" Icon="@Icons.Material.Outlined.StarOutline" Text="@Lang["Reviews"]" />
        <ShellNavLink Href="/notifications" Icon="@Icons.Material.Outlined.Notifications" Text="@Lang["Notifications"]" />
        <ShellNavLink Href="/profile" Icon="@Icons.Material.Outlined.Settings" Text="@Lang["Profile"]" />
    </NavItems>
    <PublicNavItems>
        <ShellNavLink Href="/login" Icon="@Icons.Material.Outlined.Login" Text="@Lang["Log in"]" />
        <ShellNavLink Href="/register" Icon="@Icons.Material.Outlined.PersonAdd" Text="@Lang["Register"]" />
    </PublicNavItems>
    <ChildContent>
        @if (_checkingApproval && !OpenWhileWaiting)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (Approval.MustWait && !OpenWhileWaiting)
        {
            @* Pending, suspended or no profile yet: every page but Profile shows the same message *@
            <AwaitingApproval State="Approval.Current" OnLogout="Logout" />
        }
        else
        {
            @Body
        }
    </ChildContent>
</AppShell>

@code {
    [Inject] private ILanguageService Lang { get; set; } = default!;
    [Inject] private NotificationHubService Hub { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private DoctorApproval Approval { get; set; } = default!;
    [Inject] private JwtAuthenticationStateProvider AuthState { get; set; } = default!;

    // Pages a doctor can still use while waiting for approval
    private static readonly string[] OpenPages = ["profile", "login", "register"];

    private bool _checkingApproval = true;

    private bool OpenWhileWaiting
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return OpenPages.Contains(path, StringComparer.OrdinalIgnoreCase);
        }
    }

    // Red dot on the bell: a live notification arrived and the notifications page hasn't been opened since
    private bool _newNotification;

    protected override async Task OnInitializedAsync()
    {
        Hub.PendingCountChanged += OnPendingCountChanged;
        Hub.NotificationReceived += OnNotificationReceived;
        Navigation.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        // Know the approval state before the first page shows, so a pending doctor never sees it
        _userId = (await AuthState.GetAuthenticationStateAsync()).User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await Approval.RefreshAsync();
        _checkingApproval = false;

        await Hub.InitializeAsync();
    }

    private string? _userId;

    // Login or logout: start over for the new account. Same account (a saved profile, a changed
    // password): just re-check quietly, so the page being used isn't replaced by a spinner.
    private void OnAuthStateChanged(Task<AuthenticationState> stateTask) => InvokeAsync(async () =>
    {
        var userId = (await stateTask).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != _userId)
        {
            _userId = userId;
            Approval.Reset();
            _checkingApproval = true;
            StateHasChanged();
        }
        await Approval.RefreshAsync();
        _checkingApproval = false;
        StateHasChanged();
    });

    private async Task Logout()
    {
        await AuthState.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }

    private void OnPendingCountChanged(int count) => InvokeAsync(StateHasChanged);

    private void OnNotificationReceived(NotificationDto notification) => InvokeAsync(() =>
    {
        _newNotification = !Navigation.Uri.Contains("/notifications");
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (e.Location.Contains("/notifications")) _newNotification = false;

        // While not approved, ask again on every click so an approval opens the app straight away
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (Approval.Current == DoctorApproval.State.Approved) return;
            await Approval.RefreshAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Hub.PendingCountChanged -= OnPendingCountChanged;
        Hub.NotificationReceived -= OnNotificationReceived;
        Navigation.LocationChanged -= OnLocationChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
