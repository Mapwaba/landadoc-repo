@page "/register"

<PageTitle>Register</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Lang["Create your doctor account"]</MudText>

<div class="d-flex justify-center mt-4">
    <MudPaper Class="pa-6" MaxWidth="640px" Style="width:100%;">
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Lang["Your account"]</b></MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@Lang["First name"]" @bind-Value="_firstName" Required="true" Disabled="_accountCreated" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@Lang["Last name"]" @bind-Value="_lastName" Required="true" Disabled="_accountCreated" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@Lang["Email"]" @bind-Value="_email" InputType="InputType.Email" Required="true" Disabled="_accountCreated" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@Lang["Phone"]" @bind-Value="_phone" Disabled="_accountCreated" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="@Lang["Password"]" @bind-Value="_password" InputType="InputType.Password" Required="true"
                                  Validation="@(new Func<string, string?>(ValidatePassword))" HelperText="@Lang["At least 8 characters"]" Disabled="_accountCreated" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2"><b>@Lang["Your practice"]</b></MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="@Lang["Specialty"]" @bind-Value="_specialty" Required="true">
                        @foreach (var specialty in Specialties.All)
                        {
                            <MudSelectItem T="string" Value="@specialty">@Lang[specialty]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@Lang["License number"]" @bind-Value="_licenseNumber" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" Label="@Lang["Clinics"]" MultiSelection="true" @bind-SelectedValues="_clinicIds" ToStringFunc="ClinicName"
                               Disabled="@(_clinics.Count == 0)"
                               HelperText="@(_clinics.Count == 0 ? Lang["You can add your clinics later on your profile."] : null)">
                        @foreach (var clinic in _clinics)
                        {
                            <MudSelectItem T="Guid" Value="@clinic.Id">@clinic.Name (@clinic.City)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Label="@Lang["Consultation fee ($)"]" @bind-Value="_consultationFee" Min="0" />
                </MudItem>
            </MudGrid>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6" OnClick="Submit" Disabled="_submitting">
                @Lang["Register"]
            </MudButton>
        </MudForm>
        <MudText Class="mt-4">@Lang["Already have an account?"] <MudLink Href="/login">@Lang["Log in"]</MudLink></MudText>
    </MudPaper>
</div>

@code {
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private IAdminApiClient Admin { get; set; } = default!;
    [Inject] private JwtAuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private MudForm _form = default!;
    private string _email = "";
    private string _password = "";
    private string _firstName = "";
    private string _lastName = "";
    private string? _phone;
    private string _specialty = "";
    private string? _licenseNumber;
    private IReadOnlyCollection<Guid> _clinicIds = [];
    private decimal _consultationFee;
    private List<ClinicOptionDto> _clinics = [];

    // Set once the account exists, so a retry after a failed profile save doesn't try to
    // register the same email again (which would fail with "already exists").
    private bool _accountCreated;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _clinics = await Admin.GetClinicOptionsAsync(); }
        catch (Exception) { _clinics = []; } // the doctor can still pick clinics later on their profile
    }

    // MudSelect shows selected values with this; without it, a picked clinic appears as its id
    private string ClinicName(Guid id) => _clinics.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    private string? ValidatePassword(string password) =>
        string.IsNullOrEmpty(password) || password.Length >= 8 ? null : Lang["At least 8 characters"];

    // One form, two calls: create the account (which logs the doctor in), then create their
    // profile, which waits as Pending until an admin approves it.
    private async Task Submit()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        try
        {
            if (!_accountCreated && !await CreateAccountAsync()) return;

            var resp = await Admin.CreateMyProfileAsync(new CreateOwnDoctorProfileRequest(
                _firstName, _lastName, _specialty, null, _licenseNumber, _clinicIds.ToList(), _consultationFee));

            // A name clash says so; any other conflict means the profile already exists
            // (e.g. a double click), which is fine.
            var duplicate = await DuplicateAccountMessages.ForAsync(resp, Lang, isDoctor: true);
            if (duplicate is not null)
                _error = duplicate;
            else if (resp.IsSuccessStatusCode || resp.StatusCode == System.Net.HttpStatusCode.Conflict)
                Navigation.NavigateTo("/status");
            else
                _error = Lang["Your account was created, but your profile couldn't be saved. Please try again."];
        }
        catch (Exception)
        {
            _error = _accountCreated
                ? Lang["Your account was created, but your profile couldn't be saved. Please try again."]
                : Lang["Registration failed. Please check your details and try again."];
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<bool> CreateAccountAsync()
    {
        var resp = await Identity.RegisterDoctorAsync(new RegisterDoctorRequest(
            _email, _password, _firstName, _lastName,
            string.IsNullOrWhiteSpace(_phone) ? null : _phone));

        if (resp.IsSuccessStatusCode)
        {
            var auth = await resp.Content.ReadFromJsonAsync<AuthResponse>();
            await AuthState.MarkUserAsAuthenticated(auth!);
            _accountCreated = true;
            return true;
        }

        _error = await DuplicateAccountMessages.ForAsync(resp, Lang, isDoctor: true)
            ?? Lang["Registration failed. Please check your details and try again."];
        return false;
    }
}
