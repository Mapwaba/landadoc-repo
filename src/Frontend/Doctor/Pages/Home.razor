@page "/"
@using System.Globalization

<PageTitle>LandaDoc for Doctors</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1 class="dash-title">@Lang["Dashboard"]</h1>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_loadFailed)
        {
            <MudAlert Severity="Severity.Warning">@Lang["Your appointments couldn't be loaded. Please try again in a minute."]</MudAlert>
        }
        else
        {
            <div class="dash-stats">
                <div class="dash-stat">
                    <div class="dash-stat-icon dash-blue"><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" /></div>
                    <div>
                        <div class="dash-stat-label">@Lang["Appointments today"]</div>
                        <div class="dash-stat-value">@_todayCount</div>
                    </div>
                </div>
                <div class="dash-stat">
                    <div class="dash-stat-icon dash-green"><MudIcon Icon="@Icons.Material.Outlined.Groups" /></div>
                    <div>
                        <div class="dash-stat-label">@Lang["Total patients"]</div>
                        <div class="dash-stat-value">@_patientCount</div>
                    </div>
                </div>
                <div class="dash-stat">
                    <div class="dash-stat-icon dash-purple"><MudIcon Icon="@Icons.Material.Outlined.AttachMoney" /></div>
                    <div>
                        <div class="dash-stat-label">@Lang["Revenue (estimated)"]</div>
                        <div class="dash-stat-value">$@_revenue.ToString("0.00", CultureInfo.InvariantCulture)</div>
                    </div>
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-card-head">
                    <span>@Lang["Next appointments"]</span>
                    <a class="dash-link" href="/appointments">
                        @Lang["View agenda"] <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Style="font-size:15px;" />
                    </a>
                </div>
                <div class="dash-card-body">
                    @if (_upcoming.Count == 0)
                    {
                        <div class="dash-empty">@Lang["No upcoming appointments."]</div>
                    }
                    @foreach (var appt in _upcoming)
                    {
                        <a class="dash-appt" href="@($"/appointments/{appt.Id}")">
                            <div class="dash-appt-day" title="@appt.SlotStart.ToString("D", Culture)">@appt.SlotStart.Day</div>
                            <div class="dash-appt-text">
                                <div class="dash-appt-name">@(appt.PatientName ?? Lang["Patient"])</div>
                                <div class="dash-appt-meta">
                                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Style="font-size:14px;" />
                                    @WhenLabel(appt.SlotStart)
                                    @if (!string.IsNullOrWhiteSpace(appt.Motif))
                                    {
                                        <span>•</span> @appt.Motif
                                    }
                                </div>
                            </div>
                            <span class="status-pill status-@appt.Status.ToString().ToLowerInvariant()">@Lang[$"status.{appt.Status}"]</span>
                        </a>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <h1 class="dash-title">@Lang["LandaDoc for Doctors"]</h1>
        <MudText Class="mb-6">@Lang["Manage your schedule, appointments, and patients in one place."]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register" Class="mr-2">@Lang["Get started"]</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/login">@Lang["Log in"]</MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private IAdminApiClient Admin { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private bool _loading = true;
    private bool _loadFailed;
    private int _todayCount;
    private int _patientCount;
    private decimal _revenue;
    private List<AppointmentDto> _upcoming = [];

    private CultureInfo Culture => CultureInfo.GetCultureInfo(Lang.CurrentLanguage == "fr" ? "fr-FR" : "en-US");

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true) return;

        try
        {
            var appointmentsTask = DoctorAppointments.GetMineWithPatientNamesAsync(AppointmentsApi, Identity);
            var profileTask = Admin.GetMyProfileAsync();
            var appointments = await appointmentsTask;
            var fee = (await profileTask)?.ConsultationFee ?? 0;

            // Slot times are clinic clock times, so they compare directly with the local clock
            // (the same convention as the agenda page).
            var now = DateTime.Now;
            var active = appointments.Where(a => a.Status != AppointmentStatus.Cancelled).ToList();

            _todayCount = active.Count(a => a.SlotStart.Date == now.Date);
            _patientCount = active.Select(a => a.PatientId).Distinct().Count();
            // No per-doctor payment totals exist yet, so revenue is estimated as the
            // consultation fee for every confirmed or completed appointment.
            _revenue = fee * active.Count(a => a.Status is AppointmentStatus.Confirmed or AppointmentStatus.Completed);
            _upcoming = active
                .Where(a => a.SlotStart >= now && a.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed or AppointmentStatus.Rescheduled)
                .OrderBy(a => a.SlotStart)
                .Take(5)
                .ToList();
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        _loading = false;
    }

    // "14:30" for today, otherwise "Thu 8 Oct · 14:30" so later appointments are unambiguous
    private string WhenLabel(DateTime slot) =>
        slot.Date == DateTime.Now.Date
            ? slot.ToString("HH:mm")
            : $"{slot.ToString("ddd d MMM", Culture)} · {slot:HH:mm}";
}
