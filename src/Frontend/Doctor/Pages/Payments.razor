@page "/payments"
@attribute [Authorize]
@using System.Globalization
@using System.Text

<PageTitle>Payments</PageTitle>

<div class="ld-page">
    <div class="ld-page-head">
        <h1 class="ld-page-title">@Lang["Payments & billing"]</h1>
        <div class="ld-page-actions">
            <PrintButton Disabled="@(_loading || _loadFailed)" />
            <PdfButton Report="BuildReport" Disabled="@(_loading || _loadFailed)" />
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Warning">@Lang["Your payments couldn't be loaded. Please try again in a minute."]</MudAlert>
    }
    else
    {
        <div class="ld-stats">
            <div class="ld-stat">
                <div class="ld-stat-icon ld-tint-green"><MudIcon Icon="@Icons.Material.Outlined.AttachMoney" /></div>
                <div>
                    <div class="ld-stat-label">@Lang["Total net revenue"]</div>
                    <div class="ld-stat-value">@Money(Paid.Sum(p => p.NetAmount))</div>
                </div>
            </div>
            <div class="ld-stat">
                <div class="ld-stat-icon ld-tint-blue"><MudIcon Icon="@Icons.Material.Outlined.TrendingUp" /></div>
                <div>
                    <div class="ld-stat-label">@Lang["Transactions"]</div>
                    <div class="ld-stat-value">@Paid.Count</div>
                </div>
            </div>
            <div class="ld-stat">
                <div class="ld-stat-icon ld-tint-purple"><MudIcon Icon="@Icons.Material.Outlined.CreditCard" /></div>
                <div>
                    <div class="ld-stat-label">@Lang["Platform fees"]@FeeHint</div>
                    <div class="ld-stat-value">@Money(Paid.Sum(p => p.PlatformFee))</div>
                </div>
            </div>
            <div class="ld-stat">
                <div class="ld-stat-icon ld-tint-amber"><MudIcon Icon="@Icons.Material.Outlined.HealthAndSafety" /></div>
                <div>
                    <div class="ld-stat-label">@Lang["Owed by insurers"]</div>
                    <div class="ld-stat-value">@Money(ClaimsIn(ClaimTab.Owed).Sum(c => c.Amount))</div>
                </div>
            </div>
        </div>

        @* What LandaDoc owes the doctor, the account it's sent to, and what was already sent *@
        @if (_payouts is not null)
        {
            var balance = _payouts.Balance;
            <div class="ld-card payout-card">
                <div class="pay-head">
                    <span>@Lang["Your earnings from LandaDoc"]</span>
                </div>
                <div class="payout-grid">
                    <div class="payout-balance">
                        <div class="payout-label">@Lang["Balance due to you"]</div>
                        <div class="payout-amount @(balance.Balance < 0 ? "payout-negative" : "")">@Money(balance.Balance)</div>
                        <div class="ld-muted payout-sub">@string.Format(Lang["payoutBreakdown"], Money(balance.Earned), Money(balance.InsuranceFees), Money(balance.PaidOut))</div>
                        @if (balance.LastPayoutAt is { } last)
                        {
                            <div class="ld-muted payout-sub">@string.Format(Lang["lastPayout"], last.ToLocalTime().ToString("dd/MM/yyyy"))</div>
                        }
                        @if (balance.Balance < 0)
                        {
                            <div class="ld-muted payout-sub">@Lang["LandaDoc's fees on insurance claims are taken from your next payments."]</div>
                        }
                    </div>
                    <div class="payout-account ld-no-print">
                        <div class="payout-label">@Lang["Paid to"]</div>
                        @if (_editingAccount)
                        {
                            <div class="payout-methods">
                                <label><input type="radio" name="payout-method" checked="@(_accountForm.Method == PayoutMethod.MobileMoney)" @onchange="@(() => _accountForm.Method = PayoutMethod.MobileMoney)" /> @Lang["Mobile Money"]</label>
                                <label><input type="radio" name="payout-method" checked="@(_accountForm.Method == PayoutMethod.Bank)" @onchange="@(() => _accountForm.Method = PayoutMethod.Bank)" /> @Lang["Bank account"]</label>
                            </div>
                            <div class="payout-form">
                                <input class="ld-input" placeholder="@Lang["Name on the account"]" @bind="_accountForm.AccountName" @bind:event="oninput" />
                                @if (_accountForm.Method == PayoutMethod.MobileMoney)
                                {
                                    <select class="ld-select" @bind="_accountForm.Operator">
                                        <option value="">@Lang["Operator"]</option>
                                        @foreach (var op in Enum.GetValues<MobileMoneyOperator>())
                                        {
                                            <option value="@op">@OperatorName(op)</option>
                                        }
                                    </select>
                                    <input class="ld-input" type="tel" placeholder="@Lang["Mobile money number"]" @bind="_accountForm.MobileNumber" @bind:event="oninput" />
                                }
                                else
                                {
                                    <input class="ld-input" placeholder="@Lang["Bank"]" @bind="_accountForm.BankName" @bind:event="oninput" />
                                    <input class="ld-input" placeholder="@Lang["Account number"]" @bind="_accountForm.BankAccountNumber" @bind:event="oninput" />
                                }
                            </div>
                            @if (_accountError is not null)
                            {
                                <div class="ld-field-error payout-sub">@_accountError</div>
                            }
                            <div class="payout-actions">
                                <button type="button" class="ld-btn ld-btn-sm" @onclick="@(() => _editingAccount = false)">@Lang["Cancel"]</button>
                                <button type="button" class="ld-btn ld-btn-sm ld-btn-primary" disabled="@_savingAccount" @onclick="SaveAccount">@Lang["Save"]</button>
                            </div>
                        }
                        else if (balance.Account is { } account)
                        {
                            <div class="payout-account-line">@AccountLabel(account)</div>
                            <div class="payout-sub">
                                @if (account.IsVerified)
                                {
                                    <span class="status-pill status-confirmed">@Lang["Checked"]</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pending">@Lang["Waiting for LandaDoc to check it"]</span>
                                }
                            </div>
                            <button type="button" class="ld-btn ld-btn-sm payout-change" @onclick="EditAccount">@Lang["Change"]</button>
                        }
                        else
                        {
                            <div class="ld-muted payout-sub">@Lang["Tell LandaDoc where to send your earnings."]</div>
                            <button type="button" class="ld-btn ld-btn-sm ld-btn-primary payout-change" @onclick="EditAccount">@Lang["Add an account"]</button>
                        }
                    </div>
                </div>
                @if (_payouts.Payouts.Count > 0)
                {
                    <div class="ld-table-wrap">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>@Lang["Date"]</th>
                                    <th>@Lang["Amount"]</th>
                                    <th>@Lang["Paid to"]</th>
                                    <th>@Lang["Reference"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payout in _payouts.Payouts)
                                {
                                    <tr>
                                        <td class="ld-muted">@payout.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td style="font-weight:700;">@Money(payout.Amount)</td>
                                        <td>@payout.PaidTo</td>
                                        <td class="ld-muted">@(payout.Reference ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* Insurance claims: review new ones, then reconcile approved ones with the insurer *@
        <div class="ld-card claims-card">
            <div class="pay-head">
                <span>@Lang["Insurance claims"]</span>
                <div class="claim-tabs">
                    @foreach (var tab in Enum.GetValues<ClaimTab>())
                    {
                        var t = tab;
                        <button type="button" class="claim-tab @(_claimTab == t ? "active" : "")" @onclick="@(() => SelectTab(t))">
                            @Lang[$"claimTab.{t}"] <span class="claim-tab-count">@ClaimsIn(t).Count</span>
                        </button>
                    }
                </div>
            </div>
            @if (_claimError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="ma-3">@_claimError</MudAlert>
            }
            @if (ClaimsIn(_claimTab).Count == 0)
            {
                <div class="ld-empty">@Lang[$"claimTabEmpty.{_claimTab}"]</div>
            }
            else
            {
                <div class="ld-table-wrap">
                    <table class="ld-table">
                        <thead>
                            <tr>
                                <th>@Lang["Date"]</th>
                                <th>@Lang["Patient"]</th>
                                <th>@Lang["Insurer"]</th>
                                <th>@Lang["Member no."]</th>
                                <th>@Lang["Amount"]</th>
                                <th>@Lang["Status"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in ClaimsIn(_claimTab))
                            {
                                var claim = c;
                                _appointments.TryGetValue(claim.AppointmentId, out var appt);
                                <tr>
                                    <td class="ld-muted">@claim.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (appt is not null)
                                        {
                                            <a href="@($"/patients/{appt.PatientId}")">@(appt.PatientName ?? Lang["Patient"])</a>
                                            <div class="ld-muted claim-sub">@string.Format(Lang["apptOn"], appt.SlotStart.ToString("dd/MM/yyyy HH:mm"))</div>
                                        }
                                        else
                                        {
                                            <span class="ld-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @claim.InsurerName
                                        @if (claim.Status == InsuranceClaimStatus.Submitted && InsurerContact(claim.InsurerId) is { } contact)
                                        {
                                            <div class="ld-muted claim-sub">@contact</div>
                                        }
                                    </td>
                                    <td>
                                        @claim.MemberNumber
                                        @if (!string.IsNullOrWhiteSpace(claim.MemberName))
                                        {
                                            <div class="ld-muted claim-sub">@string.Format(Lang["mainMember"], claim.MemberName)</div>
                                        }
                                    </td>
                                    <td style="font-weight:700;">@Money(claim.Amount)</td>
                                    <td>
                                        <span class="status-pill @ClaimPill(claim.Status)">@Lang[$"claim.{claim.Status}"]</span>
                                        @if (claim.Status == InsuranceClaimStatus.Submitted && appt?.InsuranceReviewDueAt is { } dueAt)
                                        {
                                            <div class="claim-sub claim-due">@string.Format(Lang["answerBy"], dueAt.ToLocalTime().ToString("dd/MM HH:mm"))</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(claim.AuthorizationReference))
                                        {
                                            <div class="ld-muted claim-sub">@string.Format(Lang["authLabel"], claim.AuthorizationReference)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(claim.Note))
                                        {
                                            <div class="ld-muted claim-sub">@claim.Note</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(claim.InsurerReference))
                                        {
                                            <div class="ld-muted claim-sub">@string.Format(Lang["refLabel"], claim.InsurerReference)</div>
                                        }
                                    </td>
                                    <td class="claim-actions">
                                        @if (claim.Status == InsuranceClaimStatus.Submitted)
                                        {
                                            @* Approving only makes sense while the booking still waits on this claim *@
                                            @if (appt?.Status == AppointmentStatus.Pending)
                                            {
                                                <button type="button" class="ld-btn ld-btn-sm ld-btn-primary" disabled="@_busy" @onclick="@(() => StartAction(claim, ClaimAction.Approve))">@Lang["Approve"]</button>
                                            }
                                            <button type="button" class="ld-btn ld-btn-sm" disabled="@_busy" @onclick="@(() => StartAction(claim, ClaimAction.Decline))">@Lang["Decline"]</button>
                                        }
                                        else if (claim.Status == InsuranceClaimStatus.Approved)
                                        {
                                            <button type="button" class="ld-btn ld-btn-sm ld-btn-primary" disabled="@_busy" @onclick="@(() => StartAction(claim, ClaimAction.Settle))">@Lang["Paid by insurer"]</button>
                                            <button type="button" class="ld-btn ld-btn-sm" disabled="@_busy" @onclick="@(() => StartAction(claim, ClaimAction.Reject))">@Lang["Rejected"]</button>
                                        }
                                    </td>
                                </tr>
                                @if (_actionClaimId == claim.Id)
                                {
                                    <tr class="claim-action-row">
                                        <td colspan="7">
                                            @if (_action == ClaimAction.Approve)
                                            {
                                                <div class="claim-hint">@Lang["Check the cover with the insurer first, then enter the reference they gave you."]</div>
                                            }
                                            else if (_action == ClaimAction.Settle && ClaimFee(claim) is { } fee && fee > 0)
                                            {
                                                <div class="claim-hint">@string.Format(Lang["settleFeeHint"], Money(fee))</div>
                                            }
                                            <div class="claim-action">
                                                <input class="ld-input" @bind="_actionNote" @bind:event="oninput" placeholder="@ActionPlaceholder" />
                                                <button type="button" class="ld-btn ld-btn-sm ld-btn-primary" disabled="@(_busy || (_action == ClaimAction.Approve && string.IsNullOrWhiteSpace(_actionNote)))" @onclick="@(() => ConfirmAction(claim))">@Lang[$"claimConfirm.{_action}"]</button>
                                                <button type="button" class="ld-btn ld-btn-sm" @onclick="CancelAction">@Lang["Cancel"]</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="ld-card">
            <div class="pay-head">
                <span>@Lang["Transaction history"]</span>
                <button type="button" class="ld-btn ld-btn-sm" @onclick="Export" disabled="@(_payments.Count == 0)">
                    <MudIcon Icon="@Icons.Material.Outlined.Download" Style="font-size:16px;" /> @Lang["Export"]
                </button>
            </div>
            @if (_payments.Count == 0)
            {
                <div class="ld-empty">@Lang["No payments yet."]</div>
            }
            else
            {
                <div class="ld-table-wrap">
                    <table class="ld-table">
                        <thead>
                            <tr>
                                <th>@Lang["Date"]</th>
                                <th>@Lang["Patient"]</th>
                                <th>@Lang["Gross"]</th>
                                <th>@Lang["Net (received)"]</th>
                                <th>@Lang["Method"]</th>
                                <th>@Lang["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _payments)
                            {
                                <tr>
                                    <td class="ld-muted">@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (_appointments.TryGetValue(p.AppointmentId, out var appt))
                                        {
                                            <a href="@($"/patients/{appt.PatientId}")">@(appt.PatientName ?? Lang["Patient"])</a>
                                        }
                                        else
                                        {
                                            <span class="ld-muted">—</span>
                                        }
                                    </td>
                                    <td class="ld-muted" style="font-size:12px;">@Money(p.GrossAmount) (-@Short(p.PlatformFee))</td>
                                    <td style="font-weight:700;">@Money(p.NetAmount)</td>
                                    <td class="ld-muted">@MethodLabel(p)</td>
                                    <td><span class="status-pill @PillClass(p.Status)">@Lang[$"paymentStatus.{p.Status}"]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* Which insurers patients may choose when they book with this doctor *@
        @if (!_insurersFailed)
        {
            <div class="ld-card ld-no-print">
                <div class="pay-head">
                    <span>@Lang["Insurers I accept"]</span>
                </div>
                <div class="ld-card-body">
                    @if (_allInsurers.Count == 0)
                    {
                        <div class="ld-muted">@Lang["There are no partner insurers yet."]</div>
                    }
                    else
                    {
                        <label class="ins-option">
                            <input type="radio" name="ins-mode" checked="@_acceptsAll" @onchange="@(() => SetAcceptsAll(true))" />
                            @Lang["Every partner insurer, including new ones"]
                        </label>
                        <label class="ins-option">
                            <input type="radio" name="ins-mode" checked="@(!_acceptsAll)" @onchange="@(() => SetAcceptsAll(false))" />
                            @Lang["Only the insurers I tick"]
                        </label>
                        @if (!_acceptsAll)
                        {
                            <div class="ins-list">
                                @foreach (var i in _allInsurers)
                                {
                                    var insurer = i;
                                    <label class="ins-check">
                                        <input type="checkbox" checked="@_accepted.Contains(insurer.Id)" @onchange="@(e => ToggleInsurer(insurer.Id, e.Value is true))" />
                                        @insurer.Name
                                    </label>
                                }
                            </div>
                            @if (!_allInsurers.Any(i => _accepted.Contains(i.Id)))
                            {
                                <div class="ld-muted ins-note">@Lang["Patients won't be offered insurance when they book with you."]</div>
                            }
                        }
                        <div class="ins-actions">
                            @if (_insurersMessage is not null)
                            {
                                <span class="ld-muted">@_insurersMessage</span>
                            }
                            <button type="button" class="ld-btn ld-btn-sm ld-btn-primary" disabled="@_savingInsurers" @onclick="SaveInsurers">@Lang["Save"]</button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Inject] private IPaymentApiClient PaymentsApi { get; set; } = default!;
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private bool _loading = true;
    private bool _loadFailed;
    private List<PaymentDto> _payments = [];
    private Dictionary<Guid, AppointmentDto> _appointments = [];
    private List<InsuranceClaimDto> _claims = [];

    // Review = waiting for the doctor (Submitted); Owed = approved, waiting for the insurer
    // to pay (Approved); Closed = Declined, Settled or Rejected
    private enum ClaimTab { Review, Owed, Closed }
    // The actions that open the inline note box (approving needs the insurer's reference)
    private enum ClaimAction { Approve, Decline, Settle, Reject }

    private ClaimTab _claimTab = ClaimTab.Review;
    private Guid? _actionClaimId;    // claim whose note box is open, if any
    private ClaimAction _action;
    private string _actionNote = "";   // reason, or the insurer's payment reference when settling
    private bool _busy;
    private string? _claimError;

    // Money actually received: card / mobile money payments, plus insurance claims the insurer has paid.
    // An approved claim completes the booking in the ledger but stays "Owed by insurers" until settled.
    private List<PaymentDto> Paid => _payments
        .Where(p => p.Status == PaymentStatus.Completed)
        .Where(p => p.Provider != PaymentProvider.Insurance || ClaimFor(p)?.Status == InsuranceClaimStatus.Settled)
        .ToList();

    // The claim behind an insurance ledger row (its ProviderRef is "claim_<claim id>")
    private InsuranceClaimDto? ClaimFor(PaymentDto p) =>
        _claims.FirstOrDefault(c => p.ProviderRef == $"claim_{c.Id:N}");

    private List<InsuranceClaimDto> ClaimsIn(ClaimTab tab) => _claims.Where(c => tab switch
    {
        ClaimTab.Review => c.Status == InsuranceClaimStatus.Submitted,
        ClaimTab.Owed => c.Status == InsuranceClaimStatus.Approved,
        _ => c.Status is InsuranceClaimStatus.Declined or InsuranceClaimStatus.Expired or InsuranceClaimStatus.Settled or InsuranceClaimStatus.Rejected,
    }).ToList();

    // Hint text in the note box
    private string ActionPlaceholder => _action switch
    {
        ClaimAction.Approve => Lang["Insurer's reference (authorisation no. or agent's name)"],
        ClaimAction.Settle => Lang["Insurer's payment reference (optional)"],
        _ => Lang["Reason (optional)"],
    };

    // Partner insurers (for their contact details and the "Insurers I accept" card)
    private List<InsurerDto> _allInsurers = [];
    private bool _insurersFailed;
    private bool _acceptsAll = true;
    private HashSet<Guid> _accepted = [];   // keeps paused insurers the doctor chose, too
    private bool _savingInsurers;
    private string? _insurersMessage;

    // "+243 81 000 0000 · claims@insurer.cd", to call or write when checking a patient's cover
    private string? InsurerContact(Guid insurerId)
    {
        var insurer = _allInsurers.FirstOrDefault(i => i.Id == insurerId);
        var parts = new[] { insurer?.Phone, insurer?.Email }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    // " ($8 / appt)" when every paid appointment carried the same fee, as it normally does
    private string FeeHint
    {
        get
        {
            var fees = Paid.Select(p => p.PlatformFee).Distinct().ToList();
            return fees.Count == 1 ? $" ({Short(fees[0])} / {Lang["appt"]})" : "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var paymentsTask = PaymentsApi.GetMineAsDoctorAsync();
            var appointmentsTask = DoctorAppointments.GetMineWithPatientNamesAsync(AppointmentsApi, Identity); // for the patient names
            var claimsTask = PaymentsApi.GetMyClaimsAsDoctorAsync();
            _payments = await paymentsTask;
            _appointments = (await appointmentsTask).ToDictionary(a => a.Id);
            _claims = await claimsTask;
        }
        catch (Exception)
        {
            _loadFailed = true;
        }

        await LoadPayoutsAsync();

        // Not essential to the page: without them the card is hidden and contacts aren't shown
        try
        {
            var insurersTask = PaymentsApi.GetInsurersAsync();
            var choiceTask = PaymentsApi.GetMyAcceptedInsurersAsync();
            _allInsurers = await insurersTask;
            var choice = await choiceTask;
            _acceptsAll = choice.AcceptsAll;
            _accepted = choice.InsurerIds.ToHashSet();
        }
        catch (Exception)
        {
            _insurersFailed = true;
        }
        _loading = false;

        // Open on the claims that need something from the doctor
        if (ClaimsIn(ClaimTab.Review).Count == 0 && ClaimsIn(ClaimTab.Owed).Count > 0) _claimTab = ClaimTab.Owed;
    }

    private void SelectTab(ClaimTab tab)
    {
        _claimTab = tab;
        CancelAction();
    }

    // Open the note box under a claim's row
    private void StartAction(InsuranceClaimDto claim, ClaimAction action)
    {
        _actionClaimId = claim.Id;
        _action = action;
        _actionNote = "";
        _claimError = null;
    }

    private void CancelAction() => _actionClaimId = null;

    private Task ConfirmAction(InsuranceClaimDto claim)
    {
        var note = string.IsNullOrWhiteSpace(_actionNote) ? null : _actionNote.Trim();
        if (_action == ClaimAction.Approve && note is null) return Task.CompletedTask;
        return RunClaimAsync(() => _action switch
        {
            ClaimAction.Approve => PaymentsApi.ApproveClaimAsync(claim.Id, note!),
            ClaimAction.Decline => PaymentsApi.DeclineClaimAsync(claim.Id, note),
            ClaimAction.Settle => PaymentsApi.SettleClaimAsync(claim.Id, note),
            _ => PaymentsApi.RejectClaimAsync(claim.Id, note),
        });
    }

    // Run a claim action, then reload claims and payments (approving adds a ledger row)
    private async Task RunClaimAsync(Func<Task<HttpResponseMessage>> call)
    {
        _busy = true;
        _claimError = null;
        try
        {
            var resp = await call();
            if (resp.IsSuccessStatusCode)
            {
                _actionClaimId = null;
                _claims = await PaymentsApi.GetMyClaimsAsDoctorAsync();
                _payments = await PaymentsApi.GetMineAsDoctorAsync();
                await LoadPayoutsAsync();   // a settled claim's fee changes the balance
            }
            else
            {
                _claimError = resp.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? Lang["This claim can no longer be changed. Refresh the page to see where it stands."]
                    : Lang["Could not update the claim. Please try again."];
            }
        }
        catch (Exception)
        {
            _claimError = Lang["Could not update the claim. Please try again."];
        }
        _busy = false;
    }

    // ── Payouts ──────────────────────────────────────────────────────
    private DoctorPayoutsDto? _payouts;   // null hides the card (e.g. the service didn't answer)
    private bool _editingAccount;
    private bool _savingAccount;
    private string? _accountError;
    private AccountForm _accountForm = new();

    private sealed class AccountForm
    {
        public PayoutMethod Method { get; set; } = PayoutMethod.MobileMoney;
        public string AccountName { get; set; } = "";
        public MobileMoneyOperator? Operator { get; set; }
        public string MobileNumber { get; set; } = "";
        public string BankName { get; set; } = "";
        public string BankAccountNumber { get; set; } = "";
    }

    private async Task LoadPayoutsAsync()
    {
        try { _payouts = await PaymentsApi.GetMyPayoutsAsync(); }
        catch (Exception) { _payouts = null; }
    }

    private void EditAccount()
    {
        var a = _payouts?.Balance.Account;
        _accountForm = a is null ? new AccountForm() : new AccountForm
        {
            Method = a.Method,
            AccountName = a.AccountName,
            Operator = a.Operator,
            MobileNumber = a.MobileNumber ?? "",
            BankName = a.BankName ?? "",
            BankAccountNumber = a.BankAccountNumber ?? "",
        };
        _accountError = null;
        _editingAccount = true;
    }

    private async Task SaveAccount()
    {
        var f = _accountForm;
        var mobile = f.Method == PayoutMethod.MobileMoney;
        if (string.IsNullOrWhiteSpace(f.AccountName)
            || (mobile && (f.Operator is null || string.IsNullOrWhiteSpace(f.MobileNumber)))
            || (!mobile && (string.IsNullOrWhiteSpace(f.BankName) || string.IsNullOrWhiteSpace(f.BankAccountNumber))))
        {
            _accountError = Lang["Fill in every field."];
            return;
        }

        _savingAccount = true;
        _accountError = null;
        try
        {
            var resp = await PaymentsApi.SaveMyPayoutAccountAsync(new SavePayoutAccountRequest(
                f.Method, f.AccountName.Trim(), mobile ? f.Operator : null,
                mobile ? f.MobileNumber.Trim() : null, mobile ? null : f.BankName.Trim(), mobile ? null : f.BankAccountNumber.Trim()));
            if (resp.IsSuccessStatusCode)
            {
                _editingAccount = false;
                await LoadPayoutsAsync();
            }
            else
            {
                _accountError = Lang["Could not save. Please try again."];
            }
        }
        catch (Exception)
        {
            _accountError = Lang["Could not save. Please try again."];
        }
        _savingAccount = false;
    }

    private string AccountLabel(PayoutAccountDto a) => a.Method == PayoutMethod.MobileMoney
        ? $"{OperatorName(a.Operator)} · {a.MobileNumber} · {a.AccountName}"
        : $"{a.BankName} · {a.BankAccountNumber} · {a.AccountName}";

    private static string OperatorName(MobileMoneyOperator? op) => op switch
    {
        MobileMoneyOperator.Airtel => "Airtel Money",
        MobileMoneyOperator.Orange => "Orange Money",
        MobileMoneyOperator.Mpesa => "M-Pesa",
        MobileMoneyOperator.Africell => "Africell Money",
        _ => "Mobile Money",
    };

    // LandaDoc's fee on an approved claim (taken from the balance once the insurer pays)
    private decimal? ClaimFee(InsuranceClaimDto claim) =>
        _payments.FirstOrDefault(p => p.ProviderRef == $"claim_{claim.Id:N}")?.PlatformFee;

    private void SetAcceptsAll(bool value)
    {
        _acceptsAll = value;
        _insurersMessage = null;
    }

    private void ToggleInsurer(Guid id, bool accepted)
    {
        if (accepted) _accepted.Add(id); else _accepted.Remove(id);
        _insurersMessage = null;
    }

    private async Task SaveInsurers()
    {
        _savingInsurers = true;
        _insurersMessage = null;
        try
        {
            var resp = await PaymentsApi.SaveMyAcceptedInsurersAsync(new AcceptedInsurersDto(_acceptsAll, _accepted.ToList()));
            _insurersMessage = resp.IsSuccessStatusCode ? Lang["Saved."] : Lang["Could not save. Please try again."];
        }
        catch (Exception)
        {
            _insurersMessage = Lang["Could not save. Please try again."];
        }
        _savingInsurers = false;
    }

    // How a payment was made, for the Method column and the CSV export
    private string MethodLabel(PaymentDto p) => p.Provider switch
    {
        PaymentProvider.Stripe => Lang["Card"],
        PaymentProvider.MokoAfrika => Lang["Mobile Money"],
        PaymentProvider.Insurance => ClaimFor(p)?.InsurerName ?? Lang["Insurance"],
        _ => "—",
    };

    // Claim status colours: amber to review, blue awaiting insurer, green paid, red declined/rejected
    private static string ClaimPill(InsuranceClaimStatus status) => status switch
    {
        InsuranceClaimStatus.Submitted => "status-pending",
        InsuranceClaimStatus.Approved => "status-completed",
        InsuranceClaimStatus.Settled => "status-confirmed",
        _ => "status-failed",
    };

    // The PDF version of this page: the key figures, every insurance claim and every transaction
    private PdfReport BuildReport()
    {
        var dates = _payments.Select(p => p.CreatedAt.ToLocalTime()).ToList();
        var report = new PdfReport
        {
            FileName = "landadoc-payments",
            Title = Lang["Payments & billing"],
            Subtitle = dates.Count == 0 ? null : $"{Lang["Period"]}: {dates.Min():dd/MM/yyyy} - {dates.Max():dd/MM/yyyy}",
            Stats =
            [
                new(Lang["Total net revenue"], Money(Paid.Sum(p => p.NetAmount))),
                new(Lang["Transactions"], Paid.Count.ToString()),
                new(Lang["Platform fees"], Money(Paid.Sum(p => p.PlatformFee))),
                new(Lang["Owed by insurers"], Money(ClaimsIn(ClaimTab.Owed).Sum(c => c.Amount))),
            ],
        };
        if (_payouts is not null)
        {
            report.Stats.Add(new(Lang["Balance due to you"], Money(_payouts.Balance.Balance)));
            report.Sections.Add(new PdfSection
            {
                Title = Lang["Payouts from LandaDoc"],
                Note = string.Format(Lang["payoutBreakdown"], Money(_payouts.Balance.Earned), Money(_payouts.Balance.InsuranceFees), Money(_payouts.Balance.PaidOut)),
                Columns = [new(Lang["Date"]), new(Lang["Amount"], Right: true), new(Lang["Paid to"]), new(Lang["Reference"])],
                Rows = _payouts.Payouts.Select(p => new List<PdfCell>
                {
                    p.PaidAt.ToLocalTime().ToString("dd/MM/yyyy"),
                    Money(p.Amount),
                    p.PaidTo,
                    p.Reference ?? "-",
                }).ToList(),
                EmptyText = Lang["No payouts yet."],
            });
        }

        if (_claims.Count > 0)
        {
            report.Sections.Add(new PdfSection
            {
                Title = Lang["Insurance claims"],
                Columns = [new(Lang["Date"]), new(Lang["Patient"]), new(Lang["Insurer"]), new(Lang["Member no."]), new(Lang["Auth. no."]), new(Lang["Amount"], Right: true), new(Lang["Status"])],
                Rows = _claims.OrderByDescending(c => c.CreatedAt).Select(c => new List<PdfCell>
                {
                    c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy"),
                    PatientName(c.AppointmentId),
                    c.InsurerName,
                    c.MemberNumber,
                    c.AuthorizationReference ?? "-",
                    Money(c.Amount),
                    new(Lang[$"claim.{c.Status}"], ClaimPill(c.Status)),
                }).ToList(),
            });
        }

        report.Sections.Add(new PdfSection
        {
            Title = Lang["Transaction history"],
            Note = _payments.Count == 0 ? null : Lang["Totals only count the money received."],
            Columns = [new(Lang["Date"]), new(Lang["Patient"]), new(Lang["Gross"], Right: true), new(Lang["Platform fee"], Right: true), new(Lang["Net (received)"], Right: true), new(Lang["Method"]), new(Lang["Status"])],
            Rows = _payments.Select(p => new List<PdfCell>
            {
                p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy"),
                PatientName(p.AppointmentId),
                Money(p.GrossAmount),
                Money(p.PlatformFee),
                Money(p.NetAmount),
                MethodLabel(p),
                new(Lang[$"paymentStatus.{p.Status}"], PillClass(p.Status)),
            }).ToList(),
            Total = [Lang["Total"], "", Money(Paid.Sum(p => p.GrossAmount)), Money(Paid.Sum(p => p.PlatformFee)), Money(Paid.Sum(p => p.NetAmount)), "", ""],
            EmptyText = Lang["No payments yet."],
        });
        return report;
    }

    private string PatientName(Guid appointmentId) =>
        _appointments.TryGetValue(appointmentId, out var appt) ? appt.PatientName ?? Lang["Patient"] : "-";

    private async Task Export()
    {
        var csv = new StringBuilder();
        csv.AppendLine("Date,Patient,Gross,Platform fee,Net,Status,Method,Reference");
        foreach (var p in _payments)
        {
            var patient = _appointments.TryGetValue(p.AppointmentId, out var appt) ? appt.PatientName ?? "" : "";
            csv.AppendLine(string.Join(",",
                p.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
                Csv(patient),
                p.GrossAmount.ToString("0.00", CultureInfo.InvariantCulture),
                p.PlatformFee.ToString("0.00", CultureInfo.InvariantCulture),
                p.NetAmount.ToString("0.00", CultureInfo.InvariantCulture),
                p.Status,
                Csv(p.Provider is null ? "" : MethodLabel(p)),
                Csv(p.ProviderRef ?? "")));
        }
        await JS.InvokeVoidAsync("landadoc.downloadText", $"landadoc-payments-{DateTime.Now:yyyy-MM-dd}.csv", csv.ToString(), "text/csv;charset=utf-8");
    }

    // Quote values containing a comma, quote or line break (U+0022 is the double quote,
    // spelled out because a literal quote character confuses the Razor parser here)
    private static readonly char[] CsvSpecial = [',', '\u0022', '\n', '\r'];
    private static string Csv(string value) =>
        value.IndexOfAny(CsvSpecial) >= 0 ? "\u0022" + value.Replace("\u0022", "\u0022\u0022") + "\u0022" : value;

    // Paid money is green, like a confirmed appointment
    private static string PillClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Completed => "status-confirmed",
        PaymentStatus.Pending => "status-pending",
        PaymentStatus.Refunded => "status-refunded",
        _ => "status-failed",
    };

    private static string Money(decimal amount) => "$" + amount.ToString("0.00", CultureInfo.InvariantCulture);
    private static string Short(decimal amount) => amount.ToString("0.##", CultureInfo.InvariantCulture) + "$";
}
