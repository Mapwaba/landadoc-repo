@page "/appointments"
@attribute [Authorize]
@using System.Globalization
@using System.Security.Claims

<PageTitle>Appointments</PageTitle>

@* Toolbar: month title, previous / today / next, and the Month / List switch *@
<div class="agenda-toolbar">
    <div class="agenda-toolbar-left">
        <h2 class="agenda-title">@MonthTitle</h2>
        @if (_view == View.Month)
        {
            <div class="agenda-nav">
                <button type="button" class="agenda-nav-btn" @onclick="PreviousMonth" aria-label="Previous month">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />
                </button>
                <button type="button" class="agenda-nav-today" @onclick="GoToToday">@Lang["Today"]</button>
                <button type="button" class="agenda-nav-btn" @onclick="NextMonth" aria-label="Next month">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                </button>
            </div>
        }
    </div>
    <div class="agenda-views">
        <button type="button" class="agenda-view-btn @(_view == View.Month ? "active" : "")" @onclick="@(() => _view = View.Month)">
            <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" /> @Lang["Month"]
        </button>
        <button type="button" class="agenda-view-btn @(_view == View.List ? "active" : "")" @onclick="@(() => _view = View.List)">
            <MudIcon Icon="@Icons.Material.Outlined.FormatListBulleted" Size="Size.Small" /> @Lang["List"]
        </button>
    </div>
</div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_loadFailed)
{
    <MudAlert Severity="Severity.Warning">@Lang["Your appointments couldn't be loaded. Please try again in a minute."]</MudAlert>
}
else if (_view == View.List)
{
    @if (_appointments.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Lang["You have no appointments yet."]</MudAlert>
    }
    else
    {
        <MudTable Items="_appointments.OrderByDescending(a => a.SlotStart)" Hover="true">
            <HeaderContent>
                <MudTh>@Lang["Date"]</MudTh>
                <MudTh>@Lang["Patient"]</MudTh>
                <MudTh>@Lang["Motif"]</MudTh>
                <MudTh>@Lang["Status"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SlotStart.ToString("g", Culture)</MudTd>
                <MudTd>@(context.PatientName ?? "—")</MudTd>
                <MudTd>@(context.Motif ?? "—")</MudTd>
                <MudTd><span class="status-pill status-@context.Status.ToString().ToLowerInvariant()">@Lang[$"status.{context.Status}"]</span></MudTd>
                <MudTd><MudButton Href="@($"/appointments/{context.Id}")" Size="Size.Small">@Lang["View"]</MudButton></MudTd>
            </RowTemplate>
        </MudTable>
    }
}
else
{
    <div class="agenda-layout">
        @* Month grid, weeks starting on Monday *@
        <div class="agenda-calendar">
            <div class="agenda-weekdays">
                @foreach (var name in WeekdayHeaders)
                {
                    <div>@name</div>
                }
            </div>
            <div class="agenda-grid">
                @foreach (var day in CalendarDays)
                {
                    var date = day;
                    var dayAppointments = AppointmentsOn(date);
                    <div class="agenda-day @(date.Month != _month.Month ? "other-month" : "") @(date == _selected ? "selected" : "")"
                         @onclick="@(() => SelectDay(date))">
                        <div class="agenda-day-head">
                            <span class="agenda-day-number @(date == Today ? "today" : "")">@date.Day</span>
                            @if (dayAppointments.Count > 0)
                            {
                                <span class="agenda-day-count">@dayAppointments.Count</span>
                            }
                        </div>
                        @foreach (var appt in dayAppointments.Take(3))
                        {
                            <div class="agenda-chip status-@appt.Status.ToString().ToLowerInvariant()">
                                @appt.SlotStart.ToString("HH:mm") - @(appt.PatientName ?? Lang["Patient"])
                            </div>
                        }
                        @if (dayAppointments.Count > 3)
                        {
                            <div class="agenda-more">+@(dayAppointments.Count - 3)</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="agenda-side">
            @* The selected day's appointments *@
            <div class="side-card">
                <div class="side-card-title">
                    <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" /> @SelectedTitle</span>
                </div>
                <div class="side-card-body">
                    @if (SelectedAppointments.Count == 0)
                    {
                        <div class="side-empty">@Lang["No appointments this day."]</div>
                    }
                    @foreach (var appt in SelectedAppointments)
                    {
                        <a class="day-appt status-@appt.Status.ToString().ToLowerInvariant()" href="@($"/appointments/{appt.Id}")">
                            <div class="day-appt-top">
                                <span class="day-appt-time">@appt.SlotStart.ToString("HH:mm")</span>
                                <span class="status-pill status-@appt.Status.ToString().ToLowerInvariant()">@Lang[$"status.{appt.Status}"]</span>
                            </div>
                            <div class="day-appt-name">@(appt.PatientName ?? Lang["Patient"])</div>
                            @if (!string.IsNullOrWhiteSpace(appt.Motif))
                            {
                                <div class="day-appt-meta">
                                    <MudIcon Icon="@Icons.Material.Outlined.Notes" Style="font-size:14px;" /> @appt.Motif
                                </div>
                            }
                        </a>
                    }
                </div>
            </div>

            @* Open and blocked slots for the selected day *@
            <div class="side-card">
                <div class="side-card-title side-card-title-tinted">
                    <span><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" /> @Lang["Slot management"]</span>
                    <a class="side-card-action" href="/schedule">@Lang["Weekly template"]</a>
                </div>
                <div class="side-card-body">
                    @if (_loadingSlots)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_slotsFailed)
                    {
                        <div class="side-empty">@Lang["Slots are unavailable right now."]</div>
                    }
                    else
                    {
                        <div class="slot-label">@Lang["Open for booking"]</div>
                        @if (_openSlots.Count == 0)
                        {
                            <div class="side-empty">@Lang["No open slots this day."]</div>
                        }
                        else
                        {
                            <div class="slot-grid">
                                @foreach (var slot in _openSlots)
                                {
                                    <div class="slot slot-open">@slot</div>
                                }
                            </div>
                        }

                        @if (_blockedSlots.Count > 0)
                        {
                            <div class="slot-divider"></div>
                            <div class="slot-label slot-label-blocked">@Lang["Blocked slots"]</div>
                            <div class="slot-grid">
                                @foreach (var slot in _blockedSlots)
                                {
                                    <div class="slot slot-blocked">@slot</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private IAvailabilityApiClient Availability { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private enum View { Month, List }

    private View _view = View.Month;
    private bool _loading = true;
    private bool _loadFailed;
    private List<AppointmentDto> _appointments = [];
    private Dictionary<DayOfWeekEnum, ScheduleDayDto> _schedule = [];
    private Guid _doctorId;

    private DateOnly _month;      // first day of the month on screen
    private DateOnly _selected;   // day shown in the right-hand panel

    private bool _loadingSlots;
    private bool _slotsFailed;
    private List<string> _openSlots = [];
    private List<string> _blockedSlots = [];

    // Slot times are stored as clinic clock times (UTC-kind, no offset applied), so dates and
    // times are read straight off SlotStart rather than converted to the browser's time zone.
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private CultureInfo Culture => CultureInfo.GetCultureInfo(Lang.CurrentLanguage == "fr" ? "fr-FR" : "en-US");

    protected override async Task OnInitializedAsync()
    {
        _selected = Today;
        _month = new DateOnly(Today.Year, Today.Month, 1);

        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _doctorId);

            var appointmentsTask = AppointmentsApi.GetMineAsync();
            var scheduleTask = Availability.GetMyScheduleAsync();
            _appointments = await appointmentsTask;
            _schedule = (await scheduleTask).ToDictionary(d => d.Day);
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        _loading = false;

        if (!_loadFailed) await LoadSlotsAsync();
    }

    private async Task SelectDay(DateOnly date)
    {
        _selected = date;
        if (date.Month != _month.Month || date.Year != _month.Year)
            _month = new DateOnly(date.Year, date.Month, 1);
        await LoadSlotsAsync();
    }

    private Task PreviousMonth() { _month = _month.AddMonths(-1); return Task.CompletedTask; }
    private Task NextMonth() { _month = _month.AddMonths(1); return Task.CompletedTask; }
    private Task GoToToday() => SelectDay(Today);

    // Open slots come from the availability API. "Blocked" are the remaining slots of the
    // weekly schedule that aren't open and aren't taken by one of this day's appointments.
    private async Task LoadSlotsAsync()
    {
        _loadingSlots = true;
        _slotsFailed = false;
        _openSlots = [];
        _blockedSlots = [];
        StateHasChanged();

        try
        {
            _openSlots = await Availability.GetSlotsAsync(_doctorId, _selected);

            var booked = SelectedAppointments
                .Where(a => a.Status != AppointmentStatus.Cancelled)
                .Select(a => a.SlotStart.ToString("HH:mm"))
                .ToHashSet();
            var open = _openSlots.ToHashSet();
            _blockedSlots = ScheduledSlots(_selected).Where(s => !open.Contains(s) && !booked.Contains(s)).ToList();
        }
        catch (Exception)
        {
            _slotsFailed = true;
        }
        _loadingSlots = false;
    }

    private List<string> ScheduledSlots(DateOnly date)
    {
        var day = Enum.Parse<DayOfWeekEnum>(date.DayOfWeek.ToString());
        if (!_schedule.TryGetValue(day, out var s) || s.SlotMinutes <= 0) return [];

        var slots = new List<string>();
        for (var t = s.OpenTime; t.AddMinutes(s.SlotMinutes) <= s.CloseTime && t >= s.OpenTime; t = t.AddMinutes(s.SlotMinutes))
            slots.Add(t.ToString("HH:mm"));
        return slots;
    }

    private List<AppointmentDto> AppointmentsOn(DateOnly date) =>
        _appointments
            .Where(a => DateOnly.FromDateTime(a.SlotStart) == date)
            .OrderBy(a => a.SlotStart)
            .ToList();

    private List<AppointmentDto> SelectedAppointments => AppointmentsOn(_selected);

    // Monday-first weeks covering the whole month (4 to 6 rows)
    private IEnumerable<DateOnly> CalendarDays
    {
        get
        {
            var start = _month.AddDays(-(((int)_month.DayOfWeek + 6) % 7));
            var end = _month.AddMonths(1).AddDays(-1);
            end = end.AddDays((7 - ((int)end.DayOfWeek + 6) % 7 - 1) % 7);
            for (var d = start; d <= end; d = d.AddDays(1))
                yield return d;
        }
    }

    private IEnumerable<string> WeekdayHeaders =>
        Enumerable.Range(0, 7)
            .Select(i => Culture.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)((i + 1) % 7)))
            .Select(n => n.TrimEnd('.').ToUpper(Culture));

    private string MonthTitle => Capitalize(_month.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", Culture));

    private string SelectedTitle => Culture.TextInfo.ToTitleCase(
        _selected.ToDateTime(TimeOnly.MinValue).ToString(Lang.CurrentLanguage == "fr" ? "dddd d MMMM" : "dddd, MMMM d", Culture));

    private string Capitalize(string s) => s.Length == 0 ? s : char.ToUpper(s[0], Culture) + s[1..];
}
