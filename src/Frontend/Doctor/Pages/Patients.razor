@page "/patients"
@attribute [Authorize]
@using System.Globalization

<PageTitle>Patients</PageTitle>

<div class="ld-page">
    <div class="ld-page-head">
        <h1 class="ld-page-title">@Lang["My patients"]</h1>
        <div class="ld-page-actions">
            <PrintButton Disabled="@(_loading || _loadFailed)" />
            <PdfButton Report="BuildReport" Disabled="@(_loading || _loadFailed)" />
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Warning">@Lang["Your appointments couldn't be loaded. Please try again in a minute."]</MudAlert>
    }
    else
    {
        @if (_contactsFailed)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">@Lang["Patient details couldn't be loaded. Please try again in a minute."]</MudAlert>
        }
        <div class="ld-card">
            <div class="pt-search">
                <div class="ld-input-wrap" style="max-width:360px;">
                    <input class="ld-input pt-search-input" placeholder="@Lang["Search by last or first name..."]" @bind="_query" @bind:event="oninput" />
                    <span class="pt-search-icon"><MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:17px;" /></span>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_query))
            {
                @* On paper the search box is gone, so say the list is filtered *@
                <div class="ld-print-only pt-print-filter">@string.Format(Lang["searchFilter"], _query.Trim())</div>
            }

            @if (Filtered.Count == 0)
            {
                <div class="ld-empty">@(_patients.Count == 0 ? Lang["You don't have any patients yet."] : Lang["No patient matches your search."])</div>
            }
            else
            {
                <div class="ld-table-wrap">
                    <table class="ld-table">
                        <thead>
                            <tr>
                                <th>@Lang["Patient"]</th>
                                <th>@Lang["Sex / age"]</th>
                                <th>@Lang["Phone"]</th>
                                <th>@Lang["Last visit"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Filtered)
                            {
                                <tr>
                                    <td>
                                        <div class="ld-person">
                                            <span class="pt-avatar"><MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:18px;" /></span>
                                            <div>
                                                <div>@p.Name</div>
                                                <div class="pt-id">ID: #@ShortId(p.Id)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>@(p.Contact?.Gender is { } g ? Lang[g] : "—")</div>
                                        @if (p.Contact?.DateOfBirth is { } dob)
                                        {
                                            <div class="pt-sub">@AgeLabel(dob)</div>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Contact?.Phone) ? "—" : p.Contact!.Phone)</td>
                                    <td>
                                        @if (p.LastVisit is { } last)
                                        {
                                            <span class="pt-visit">@last.ToString("d MMM yyyy", Culture)</span>
                                        }
                                        else
                                        {
                                            <span class="ld-muted">—</span>
                                        }
                                    </td>
                                    <td class="ld-num">
                                        <a class="pt-file" href="@($"/patients/{p.Id}")">
                                            @Lang["File"] <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Style="font-size:17px;" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private bool _loading = true;
    private bool _loadFailed;
    private bool _contactsFailed;
    private string _query = "";
    private List<PatientRow> _patients = [];

    private CultureInfo Culture => CultureInfo.GetCultureInfo(Lang.CurrentLanguage == "fr" ? "fr-FR" : "en-US");

    private List<PatientRow> Filtered => string.IsNullOrWhiteSpace(_query)
        ? _patients
        : _patients.Where(p => p.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    // Patients = everyone with a non-cancelled appointment with this doctor. Sex, age and phone
    // come from Identity, which only returns those same patients.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var appointmentsTask = AppointmentsApi.GetMineAsync();
            var contactsTask = Identity.GetMyPatientsAsync();
            var appointments = (await appointmentsTask).Where(a => a.Status != AppointmentStatus.Cancelled).ToList();

            Dictionary<Guid, PatientContactDto> contacts = [];
            try { contacts = (await contactsTask).ToDictionary(c => c.Id); }
            catch (Exception) { _contactsFailed = true; } // names still come from the appointments

            var now = DateTime.Now; // slot times are clinic clock times, like the agenda
            _patients = appointments
                .GroupBy(a => a.PatientId)
                .Select(g =>
                {
                    contacts.TryGetValue(g.Key, out var contact);
                    var name = contact is not null
                        ? $"{contact.LastName} {contact.FirstName}"
                        : g.Select(a => a.PatientName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? Lang["Patient"];
                    var lastVisit = g.Where(a => a.SlotStart < now).Select(a => (DateTime?)a.SlotStart).Max();
                    return new PatientRow(g.Key, name, contact, lastVisit);
                })
                .OrderBy(p => p.Name)
                .ToList();
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        _loading = false;
    }

    // The PDF has the list as filtered on screen
    private PdfReport BuildReport()
    {
        var patients = Filtered;
        var now = DateTime.Now;
        return new PdfReport
        {
            FileName = "landadoc-patients",
            Title = Lang["My patients"],
            Subtitle = string.IsNullOrWhiteSpace(_query) ? null : string.Format(Lang["searchFilter"], _query.Trim()),
            Stats =
            [
                new(Lang["Total patients"], patients.Count.ToString()),
                new(Lang["Seen in the last 30 days"], patients.Count(p => p.LastVisit >= now.AddDays(-30)).ToString()),
            ],
            Sections =
            [
                new PdfSection
                {
                    Title = Lang["My patients"],
                    Columns = [new(Lang["Patient"]), new("ID"), new(Lang["Sex"]), new(Lang["Age"]), new(Lang["Phone"]), new(Lang["Last visit"])],
                    Rows = patients.Select(p => new List<PdfCell>
                    {
                        p.Name,
                        "#" + ShortId(p.Id),
                        p.Contact?.Gender is { } g ? Lang[g] : "-",
                        p.Contact?.DateOfBirth is { } dob ? AgeLabel(dob) : "-",
                        string.IsNullOrWhiteSpace(p.Contact?.Phone) ? "-" : p.Contact!.Phone!,
                        p.LastVisit is { } last ? last.ToString("d MMM yyyy", Culture) : "-",
                    }).ToList(),
                    EmptyText = _patients.Count == 0 ? Lang["You don't have any patients yet."] : Lang["No patient matches your search."],
                },
            ],
        };
    }

    private string AgeLabel(DateOnly dob)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year - (today < dob.AddYears(today.Year - dob.Year) ? 1 : 0);
        return string.Format(Lang["ageYears"], age);
    }

    private static string ShortId(Guid id) => id.ToString("N")[..6].ToUpperInvariant();

    private record PatientRow(Guid Id, string Name, PatientContactDto? Contact, DateTime? LastVisit);
}
