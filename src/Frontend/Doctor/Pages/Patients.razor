@page "/patients"
@attribute [Authorize]
@using System.Globalization

<PageTitle>Patients</PageTitle>

<div class="ld-page">
    <div class="ld-page-head">
        <h1 class="ld-page-title">@Lang["Patients"]</h1>
        <div class="ld-input-wrap" style="width:280px;">
            <input class="ld-input" placeholder="@Lang["Search a patient"]" @bind="_query" @bind:event="oninput" />
            <span class="ld-input-icon"><MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:17px;" /></span>
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Warning">@Lang["Your appointments couldn't be loaded. Please try again in a minute."]</MudAlert>
    }
    else
    {
        <div class="ld-card">
            @if (Filtered.Count == 0)
            {
                <div class="ld-empty">@(_patients.Count == 0 ? Lang["You don't have any patients yet."] : Lang["No patient matches your search."])</div>
            }
            else
            {
                <div class="ld-table-wrap">
                    <table class="ld-table">
                        <thead>
                            <tr>
                                <th>@Lang["Patient"]</th>
                                <th class="ld-num">@Lang["Appointments"]</th>
                                <th>@Lang["Last visit"]</th>
                                <th>@Lang["Next appointment"]</th>
                                <th>@Lang["Last reason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Filtered)
                            {
                                <tr>
                                    <td>
                                        <div class="ld-person">
                                            <span class="ld-person-avatar">@Initials(p.Name)</span> @p.Name
                                        </div>
                                    </td>
                                    <td class="ld-num">@p.AppointmentCount</td>
                                    <td>@(p.LastVisit is { } last ? last.ToString("d MMM yyyy", Culture) : "—")</td>
                                    <td>
                                        @if (p.Next is { } next)
                                        {
                                            <a href="@($"/appointments/{next.Id}")">@next.SlotStart.ToString("d MMM yyyy · HH:mm", Culture)</a>
                                        }
                                        else
                                        {
                                            <span class="ld-muted">—</span>
                                        }
                                    </td>
                                    <td class="ld-muted">@(p.LastMotif ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private bool _loading = true;
    private bool _loadFailed;
    private string _query = "";
    private List<PatientRow> _patients = [];

    private CultureInfo Culture => CultureInfo.GetCultureInfo(Lang.CurrentLanguage == "fr" ? "fr-FR" : "en-US");

    private List<PatientRow> Filtered => string.IsNullOrWhiteSpace(_query)
        ? _patients
        : _patients.Where(p => p.Name.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    // The patient list is built from the doctor's appointments: everyone they have seen or will see.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var now = DateTime.Now; // slot times are clinic clock times, like the agenda
            var appointments = (await AppointmentsApi.GetMineAsync())
                .Where(a => a.Status != AppointmentStatus.Cancelled)
                .ToList();

            _patients = appointments
                .GroupBy(a => a.PatientId)
                .Select(g =>
                {
                    var past = g.Where(a => a.SlotStart < now).OrderByDescending(a => a.SlotStart).ToList();
                    return new PatientRow(
                        g.Select(a => a.PatientName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? Lang["Patient"],
                        g.Count(),
                        past.FirstOrDefault()?.SlotStart,
                        g.Where(a => a.SlotStart >= now).OrderBy(a => a.SlotStart).FirstOrDefault(),
                        g.OrderByDescending(a => a.SlotStart).Select(a => a.Motif).FirstOrDefault(m => !string.IsNullOrWhiteSpace(m)));
                })
                .OrderBy(p => p.Name)
                .ToList();
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        _loading = false;
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private record PatientRow(string Name, int AppointmentCount, DateTime? LastVisit, AppointmentDto? Next, string? LastMotif);
}
