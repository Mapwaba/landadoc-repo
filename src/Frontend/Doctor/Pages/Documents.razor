@page "/documents"
@attribute [Authorize]

<PageTitle>Medical documents</PageTitle>

@* Documents live in each patient's file (/patients/{id}); this page points there. *@
<div class="ld-page">
    <div class="ld-page-head">
        <h1 class="ld-page-title">@Lang["Medical documents"]</h1>
    </div>

    <div class="doc-info">
        <MudIcon Icon="@Icons.Material.Outlined.Description" Style="font-size:18px;" />
        <span>
            @Lang["To view documents (prescriptions, tests, x-rays), open the relevant"]
            <a href="/patients">@Lang["Patient file"]</a>.
        </span>
    </div>

    <div class="ld-card">
        <div class="doc-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:36px; color:#CBD2DC;" />
            <div class="doc-empty-title">@Lang["Find a patient"]</div>
            <div class="ld-muted">@Lang["Open the patient list to see their documents."]</div>
            <a class="ld-btn ld-btn-primary" href="/patients" style="margin-top:16px;">@Lang["Go to patients"]</a>
        </div>
    </div>
</div>

@code {
    [Inject] private ILanguageService Lang { get; set; } = default!;
}
