@page "/profile"
@attribute [Authorize]

<PageTitle>My profile</PageTitle>

<div class="ld-page ld-page-narrow">
    <div class="ld-page-head">
        <h1 class="ld-page-title">@(_isNew ? Lang["My profile"] : Lang["My public profile"])</h1>
        @if (!_isNew && !_loading)
        {
            <a class="ld-btn" href="/workplace">
                <MudIcon Icon="@Icons.Material.Outlined.Apartment" Style="font-size:16px;" /> @Lang["View my workplace"]
            </a>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_isNew)
    {
        @* First-time setup for a doctor account without a profile yet *@
        <MudPaper Class="pa-6">
            <MudForm @ref="_form">
                <MudTextField T="string" Label="@Lang["First name"]" @bind-Value="_firstName" Required="true" Class="mb-3" />
                <MudTextField T="string" Label="@Lang["Last name"]" @bind-Value="_lastName" Required="true" Class="mb-3" />
                <MudSelect T="string" Label="@Lang["Specialty"]" @bind-Value="_specialty" Required="true" Class="mb-3">
                    @foreach (var specialty in Specialties.All)
                    {
                        <MudSelectItem T="string" Value="@specialty">@Lang[specialty]</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="@Lang["License number"]" @bind-Value="_licenseNumber" Class="mb-3" />
                <MudTextField T="string" Label="@Lang["Bio"]" @bind-Value="_bio" Lines="3" Class="mb-3" />
                <MudSelect T="Guid" Label="@Lang["Clinics"]" MultiSelection="true" @bind-SelectedValues="_clinicIds" ToStringFunc="ClinicName" Class="mb-3">
                    @foreach (var clinic in _clinics)
                    {
                        <MudSelectItem T="Guid" Value="@clinic.Id">@clinic.Name (@clinic.City)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="decimal" Label="@Lang["Consultation fee ($)"]" @bind-Value="_consultationFee" Min="0" Class="mb-3" />

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
                }

                <div class="ld-form-actions" style="margin-top:8px;">
                    <button type="button" class="ld-btn ld-btn-primary" @onclick="CreateProfile" disabled="@_saving">@Lang["Create profile"]</button>
                </div>
            </MudForm>
        </MudPaper>
    }
    else if (_editing)
    {
        @* Card 1: everything on the profile, from name to consultation fee *@
        <div class="ld-card">
            <div class="pp-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Badge" Style="font-size:19px;" /> @Lang["Doctor information"]
            </div>
            <div class="ld-card-body">
                <div class="ld-form-grid">
                    <div class="ld-field">
                        <label>@Lang["First name"]</label>
                        <input class="ld-input @(_infoSubmitted && Blank(_firstName) ? "invalid" : "")" @bind="_firstName" @bind:event="oninput" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Last name"]</label>
                        <input class="ld-input @(_infoSubmitted && Blank(_lastName) ? "invalid" : "")" @bind="_lastName" @bind:event="oninput" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Specialty"]</label>
                        <select class="ld-select" @bind="_specialty">
                            @foreach (var specialty in SpecialtyOptions)
                            {
                                <option value="@specialty">@Lang[specialty]</option>
                            }
                        </select>
                    </div>
                    <div class="ld-field">
                        <label>@Lang["License number"]</label>
                        <input class="ld-input" @bind="_licenseNumber" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Phone"]</label>
                        <div class="ld-input-wrap">
                            <input class="ld-input" type="tel" @bind="_phone" />
                            <span class="ld-input-icon"><MudIcon Icon="@Icons.Material.Outlined.Phone" Style="font-size:17px;" /></span>
                        </div>
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Consultation fee ($)"]</label>
                        <input class="ld-input @(_infoSubmitted && _consultationFee < 0 ? "invalid" : "")" type="number" min="0" step="0.01" @bind="_consultationFee" />
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["Clinics"]</label>
                        <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_clinicIds" ToStringFunc="ClinicName" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Placeholder="@Lang["Choose your clinics"]">
                            @foreach (var clinic in _clinics)
                            {
                                <MudSelectItem T="Guid" Value="@clinic.Id">@clinic.Name (@clinic.City)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["About"]</label>
                        <textarea class="ld-textarea" rows="4" @bind="_bio"></textarea>
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["Email"]</label>
                        <input class="ld-input" value="@_email" disabled title="@Lang["Your email is your login and can't be changed here."]" />
                    </div>
                </div>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
                }

                <div class="ld-form-actions">
                    <button type="button" class="ld-btn" @onclick="CancelEdit">@Lang["Back to my profile"]</button>
                    <button type="button" class="ld-btn ld-btn-primary" @onclick="SaveInfo" disabled="@_saving">
                        <MudIcon Icon="@Icons.Material.Outlined.Save" Style="font-size:17px;" /> @Lang["Save changes"]
                    </button>
                </div>
            </div>
        </div>

        @* Card 2: password *@
        <div class="ld-card">
            <div class="pp-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Lock" Style="font-size:19px;" /> @Lang["Password"]
            </div>
            <div class="ld-card-body">
                <div class="ld-form-grid">
                    <div class="ld-field ld-field-full">
                        <label>@Lang["Current password"]</label>
                        <input class="ld-input @(_pwSubmitted && Blank(_currentPassword) ? "invalid" : "")" type="password" autocomplete="current-password" @bind="_currentPassword" @bind:event="oninput" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["New password"]</label>
                        <input class="ld-input @(_pwSubmitted && NewPasswordError is not null ? "invalid" : "")" type="password" autocomplete="new-password" @bind="_newPassword" @bind:event="oninput" />
                        <span class="ld-muted" style="font-size:12px;">@Lang["At least 8 characters"]</span>
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Confirm new password"]</label>
                        <input class="ld-input @(_pwSubmitted && _confirmPassword != _newPassword ? "invalid" : "")" type="password" autocomplete="new-password" @bind="_confirmPassword" @bind:event="oninput" />
                    </div>
                </div>

                @if (_pwError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_pwError</MudAlert>
                }

                <div class="ld-form-actions">
                    <button type="button" class="ld-btn ld-btn-primary" @onclick="ChangePassword" disabled="@_changingPassword">
                        <MudIcon Icon="@Icons.Material.Outlined.Key" Style="font-size:17px;" /> @Lang["Change password"]
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* Public profile, as patients see it *@
        <div class="ld-card">
            <div class="pp-banner">
                <button type="button" class="pp-edit" title="@Lang["Edit"]" aria-label="@Lang["Edit"]" @onclick="StartEdit">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:18px;" />
                </button>
            </div>
            <div class="pp-body">
                <div class="pp-avatar"><MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:38px;" /></div>
                <div class="pp-name">@Lang["Dr."] @_firstName @_lastName</div>
                <div class="pp-specialty">@Lang[_specialty]</div>
                @if (MyClinicNames.Count > 0)
                {
                    <div class="pp-clinic">@string.Join(" · ", MyClinicNames)</div>
                }

                <div class="pp-about">
                    <div class="pp-section-title">@Lang["About"]</div>
                    <div class="pp-about-text">@(string.IsNullOrWhiteSpace(_bio) ? Lang["Add a short presentation so patients get to know you."] : _bio)</div>
                </div>

                <div class="pp-columns">
                    <div>
                        <div class="pp-section-title pp-rule">@Lang["Contact details"]</div>
                        <div class="pp-line"><MudIcon Icon="@Icons.Material.Outlined.MailOutline" Style="font-size:17px;" /> @(_email ?? "—")</div>
                        <div class="pp-line"><MudIcon Icon="@Icons.Material.Outlined.Phone" Style="font-size:17px;" /> @(Blank(_phone) ? Lang["Not provided"] : _phone)</div>
                    </div>
                    <div>
                        <div class="pp-section-title pp-rule">@Lang["Professional information"]</div>
                        <div class="pp-line">
                            <MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" Style="font-size:17px;" /> @Lang["Licence"]:
                            <span class="pp-badge">@(_licenseNumber ?? "—")</span>
                        </div>
                        <div class="pp-line">
                            <MudIcon Icon="@Icons.Material.Outlined.Payments" Style="font-size:17px;" /> @Lang["Consultation"]:
                            <b>$@_consultationFee.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</b>
                        </div>
                    </div>
                </div>

                <a class="ld-btn pp-wide" href="/services">@Lang["Manage my rates and acts"]</a>
            </div>
        </div>

        <div class="ld-form-actions">
            <button type="button" class="ld-btn pp-logout" @onclick="Logout">@Lang["Log out"]</button>
        </div>
    }
</div>

@code {
    [Inject] private IAdminApiClient Admin { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private JwtAuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm _form = default!;
    private bool _loading = true;
    private bool _isNew;
    private bool _editing;
    private bool _saving;
    private bool _infoSubmitted;
    private string? _error;

    private string? _email;
    private string? _phone;
    private string _firstName = "";
    private string _lastName = "";
    private string _specialty = "";
    private string? _licenseNumber;
    private string? _bio;
    private IReadOnlyCollection<Guid> _clinicIds = [];
    private decimal _consultationFee;
    private List<ClinicDto> _clinics = [];
    private DoctorProfileDto? _saved;   // last saved profile, restored when an edit is cancelled
    private string? _savedPhone;

    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _pwSubmitted;
    private bool _changingPassword;
    private string? _pwError;

    private List<string> MyClinicNames =>
        _clinics.Where(c => _clinicIds.Contains(c.Id)).Select(c => c.Name.ToUpperInvariant()).ToList();

    // The usual list, plus the doctor's current specialty if it was typed in before the list existed
    private IEnumerable<string> SpecialtyOptions =>
        Specialties.All.Contains(_specialty) || Blank(_specialty) ? Specialties.All : Specialties.All.Prepend(_specialty);

    private string? NewPasswordError =>
        _newPassword.Length < 8 ? Lang["At least 8 characters"]
        : _newPassword == _currentPassword ? Lang["The new password must be different from the current one."]
        : null;

    protected override async Task OnInitializedAsync()
    {
        var clinicsTask = Admin.GetClinicsAsync();
        var profileTask = Admin.GetMyProfileAsync();
        var meTask = Identity.GetMeAsync();

        _clinics = await clinicsTask;
        var profile = await profileTask;
        try
        {
            var me = await meTask;
            _email = me?.Email;
            _phone = _savedPhone = Blank(me?.Phone) ? null : me!.Phone;
        }
        catch (Exception) { } // contact details are optional on this page

        if (profile is null) _isNew = true;
        else Apply(profile);
        _loading = false;
    }

    private void Apply(DoctorProfileDto profile)
    {
        _saved = profile;
        _firstName = profile.FirstName;
        _lastName = profile.LastName;
        _specialty = profile.Specialty;
        _licenseNumber = profile.LicenseNumber;
        _bio = profile.Bio;
        _clinicIds = profile.Clinics.Select(c => c.Id).ToList();
        _consultationFee = profile.ConsultationFee;
    }

    private void StartEdit()
    {
        _error = _pwError = null;
        _infoSubmitted = _pwSubmitted = false;
        _editing = true;
    }

    private void CancelEdit()
    {
        if (_saved is not null) Apply(_saved);
        _phone = _savedPhone;
        _currentPassword = _newPassword = _confirmPassword = "";
        _editing = false;
    }

    private async Task CreateProfile()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        var resp = await Admin.CreateMyProfileAsync(new CreateOwnDoctorProfileRequest(
            _firstName, _lastName, _specialty, _bio, _licenseNumber, _clinicIds.ToList(), _consultationFee));
        var duplicate = await DuplicateAccountMessages.ForAsync(resp, Lang, isDoctor: true);
        _saving = false;

        if (duplicate is not null)
        {
            _error = duplicate;
        }
        else if (resp.IsSuccessStatusCode)
        {
            var profile = await Admin.GetMyProfileAsync();
            if (profile is not null) Apply(profile);
            _isNew = false;
            Snackbar.Add(Lang["Profile saved."], Severity.Success);
        }
        else
        {
            _error = Lang["Could not save your profile. Please try again."];
        }
    }

    // Name, specialty, licence, bio, clinics and fee live on the doctor profile (Admin service);
    // name and phone also live on the account (Identity), so both are saved.
    private async Task SaveInfo()
    {
        _infoSubmitted = true;
        _error = null;
        if (Blank(_firstName) || Blank(_lastName) || Blank(_specialty) || _consultationFee < 0)
        {
            _error = Lang["Please fill in the highlighted fields."];
            return;
        }

        _saving = true;
        try
        {
            // Account first: it rejects a name or phone already used, so nothing is half-saved
            var accountResp = await Identity.UpdateMeAsync(new UpdateMeRequest(_firstName.Trim(), _lastName.Trim(), _phone));
            var duplicate = await DuplicateAccountMessages.ForAsync(accountResp, Lang, isDoctor: true);
            if (duplicate is not null || !accountResp.IsSuccessStatusCode)
            {
                _error = duplicate ?? Lang["Could not save your profile. Please try again."];
                _saving = false;
                return;
            }

            var profileResp = await Admin.UpdateMyProfileAsync(new UpdateOwnDoctorProfileRequest(
                _bio ?? "", _clinicIds.ToList(), _consultationFee,
                _firstName.Trim(), _lastName.Trim(), _specialty, _licenseNumber ?? ""));
            duplicate = await DuplicateAccountMessages.ForAsync(profileResp, Lang, isDoctor: true);

            if (duplicate is not null)
            {
                _error = duplicate;
            }
            else if (profileResp.IsSuccessStatusCode)
            {
                var profile = await Admin.GetMyProfileAsync();
                if (profile is not null) Apply(profile);
                _savedPhone = _phone;
                AuthState.NotifyUserChanged(); // refresh the name in the sidebar
                Snackbar.Add(Lang["Profile saved."], Severity.Success);
                _editing = false;
            }
            else
            {
                _error = Lang["Could not save your profile. Please try again."];
            }
        }
        catch (Exception)
        {
            _error = Lang["Could not save your profile. Please try again."];
        }
        _saving = false;
    }

    private async Task ChangePassword()
    {
        _pwSubmitted = true;
        _pwError = null;
        if (Blank(_currentPassword))
        {
            _pwError = Lang["Enter your current password."];
            return;
        }
        if (NewPasswordError is { } invalid)
        {
            _pwError = invalid;
            return;
        }
        if (_confirmPassword != _newPassword)
        {
            _pwError = Lang["The two new passwords don't match."];
            return;
        }

        _changingPassword = true;
        try
        {
            var resp = await Identity.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
            if (resp.IsSuccessStatusCode)
            {
                // Other sessions are signed out; this one continues with the new tokens
                var auth = await resp.Content.ReadFromJsonAsync<AuthResponse>(JsonDefaults.Options);
                if (auth is not null) await AuthState.MarkUserAsAuthenticated(auth);
                _currentPassword = _newPassword = _confirmPassword = "";
                _pwSubmitted = false;
                Snackbar.Add(Lang["Your password has been changed."], Severity.Success);
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                _pwError = Lang["Your current password is incorrect."];
            }
            else
            {
                _pwError = Lang["Could not change your password. Please try again."];
            }
        }
        catch (Exception)
        {
            _pwError = Lang["Could not change your password. Please try again."];
        }
        _changingPassword = false;
    }

    private async Task Logout()
    {
        await AuthState.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }

    // MudSelect shows selected values with this; without it, a picked clinic appears as its id
    private string ClinicName(Guid id) => _clinics.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    private static bool Blank(string? value) => string.IsNullOrWhiteSpace(value);
}
