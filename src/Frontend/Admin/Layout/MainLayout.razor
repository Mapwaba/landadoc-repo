@inherits LayoutComponentBase

<MudThemeProvider Theme="LandaDocTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AppShell Subtitle="Admin">
    <NavItems>
        <ShellNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" Text="@Lang["Overview"]" />
        <ShellNavLink Href="/doctors" Icon="@Icons.Material.Outlined.MedicalServices" Text="@Lang["Doctors"]" />
        <ShellNavLink Href="/clinics" Icon="@Icons.Material.Outlined.LocalHospital" Text="@Lang["Clinics"]" />
    </NavItems>
    <PublicNavItems>
        <ShellNavLink Href="/login" Icon="@Icons.Material.Outlined.Login" Text="@Lang["Log in"]" />
    </PublicNavItems>
    <ChildContent>
        @Body
    </ChildContent>
</AppShell>

@code {
    [Inject] private ILanguageService Lang { get; set; } = default!;
}
