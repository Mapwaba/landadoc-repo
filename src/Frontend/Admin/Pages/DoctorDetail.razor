@page "/doctors/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@using LandaDoc.Shared.Locations

@* One doctor, as an admin sees it: the same profile card the doctor sees on their own Profile
   page (Doctor/Pages/Profile.razor), with approve / suspend, and an edit form covering every
   field the doctor can edit. The profile (name, specialty, licence, bio, clinics, fee) lives in
   the Admin service; name and phone also live on the doctor's account in Identity, so saving
   writes to both. Email is the login and the password belongs to the doctor, so neither is
   editable here. *@

<PageTitle>Doctor</PageTitle>

<div class="ld-page ld-page-narrow">
    <div class="ld-page-head">
        <a class="ld-btn" href="/doctors">
            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Style="font-size:16px;" /> @Lang["Doctors"]
        </a>
        @if (_doctor is not null && !_editing)
        {
            <div class="dd-status">
                <span class="status-pill @StatusPill(_doctor.Status)">@Lang[$"status.{_doctor.Status}"]</span>
                @if (_doctor.Status == DoctorApprovalStatus.Pending && MissingDocuments.Count > 0)
                {
                    <span class="dd-missing">@string.Format(Lang["vdMissing"], string.Join(", ", MissingDocuments.Select(k => Lang[$"vdKind.{k}"])))</span>
                }
                @if (_doctor.Status is DoctorApprovalStatus.Pending or DoctorApprovalStatus.Suspended)
                {
                    <button type="button" class="ld-btn ld-btn-primary" disabled="@_busy" @onclick="Approve">@Lang["Approve"]</button>
                }
                @if (_doctor.Status == DoctorApprovalStatus.Approved)
                {
                    <button type="button" class="ld-btn dd-danger" disabled="@_busy" @onclick="Suspend">@Lang["Suspend"]</button>
                }
            </div>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_doctor is null)
    {
        <MudAlert Severity="Severity.Error">@Lang["Doctor not found."]</MudAlert>
    }
    else if (_editing)
    {
        @* Every field of the profile, as on the doctor's own edit form *@
        <div class="ld-card">
            <div class="pp-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Badge" Style="font-size:19px;" /> @Lang["Doctor information"]
            </div>
            <div class="ld-card-body">
                <div class="ld-form-grid">
                    <div class="ld-field">
                        <label>@Lang["First name"]</label>
                        <input class="ld-input @(_submitted && Blank(_firstName) ? "invalid" : "")" @bind="_firstName" @bind:event="oninput" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Last name"]</label>
                        <input class="ld-input @(_submitted && Blank(_lastName) ? "invalid" : "")" @bind="_lastName" @bind:event="oninput" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Specialty"]</label>
                        <select class="ld-select" @bind="_specialty">
                            @foreach (var specialty in SpecialtyOptions)
                            {
                                <option value="@specialty">@Lang[specialty]</option>
                            }
                        </select>
                    </div>
                    <div class="ld-field">
                        <label>@Lang["License number"]</label>
                        <input class="ld-input" @bind="_licenseNumber" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Phone"]</label>
                        @* Without the account (Identity unreachable) the phone can't be saved, so it's locked *@
                        <input class="ld-input" type="tel" @bind="_phone" disabled="@(_account is null)" />
                    </div>
                    <div class="ld-field">
                        <label>@Lang["Consultation fee ($)"]</label>
                        <input class="ld-input @(_submitted && _consultationFee < 0 ? "invalid" : "")" type="number" min="0" step="0.01" @bind="_consultationFee" />
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["Clinics"]</label>
                        <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_clinicIds" ToStringFunc="ClinicName" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var clinic in _clinics)
                            {
                                <MudSelectItem T="Guid" Value="@clinic.Id">@clinic.Name (@clinic.City)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["About"]</label>
                        <textarea class="ld-textarea" rows="4" @bind="_bio"></textarea>
                    </div>
                    <div class="ld-field ld-field-full">
                        <label>@Lang["Email"]</label>
                        <input class="ld-input" value="@(_account?.Email ?? "—")" disabled title="@Lang["The email is the doctor's login and can't be changed here."]" />
                    </div>
                </div>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
                }

                <div class="ld-form-actions">
                    <button type="button" class="ld-btn" @onclick="CancelEdit">@Lang["Cancel"]</button>
                    <button type="button" class="ld-btn ld-btn-primary" @onclick="Save" disabled="@_busy">
                        <MudIcon Icon="@Icons.Material.Outlined.Save" Style="font-size:17px;" /> @Lang["Save changes"]
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* The profile card, laid out like the doctor's own Profile page *@
        <div class="ld-card">
            <div class="pp-banner">
                <button type="button" class="pp-edit" title="@Lang["Edit"]" aria-label="@Lang["Edit"]" @onclick="StartEdit">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:18px;" />
                </button>
            </div>
            <div class="pp-body">
                <div class="pp-avatar"><MudIcon Icon="@Icons.Material.Outlined.Person" Style="font-size:38px;" /></div>
                <div class="pp-name">@Lang["Dr."] @_doctor.FirstName @_doctor.LastName</div>
                <div class="pp-specialty">@Lang[_doctor.Specialty]</div>
                @if (_doctor.Clinics.Count > 0)
                {
                    <div class="pp-clinic">@string.Join(" · ", _doctor.Clinics.Select(c => c.Name.ToUpperInvariant()))</div>
                }

                <div class="pp-about">
                    <div class="pp-section-title">@Lang["About"]</div>
                    <div class="pp-about-text">@(string.IsNullOrWhiteSpace(_doctor.Bio) ? Lang["No presentation yet."] : _doctor.Bio)</div>
                </div>

                <div class="pp-columns">
                    <div>
                        <div class="pp-section-title pp-rule">@Lang["Contact details"]</div>
                        <div class="pp-line"><MudIcon Icon="@Icons.Material.Outlined.MailOutline" Style="font-size:17px;" /> @(_account?.Email ?? "—")</div>
                        <div class="pp-line"><MudIcon Icon="@Icons.Material.Outlined.Phone" Style="font-size:17px;" /> @(Blank(_account?.Phone) ? Lang["Not provided"] : _account!.Phone)</div>
                    </div>
                    <div>
                        <div class="pp-section-title pp-rule">@Lang["Professional information"]</div>
                        <div class="pp-line">
                            <MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" Style="font-size:17px;" /> @Lang["Licence"]:
                            <span class="pp-badge">@(_doctor.LicenseNumber ?? "—")</span>
                        </div>
                        <div class="pp-line">
                            <MudIcon Icon="@Icons.Material.Outlined.Payments" Style="font-size:17px;" /> @Lang["Consultation"]:
                            <b>$@_doctor.ConsultationFee.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</b>
                        </div>
                        <div class="pp-line">
                            <MudIcon Icon="@Icons.Material.Outlined.Event" Style="font-size:17px;" />
                            @string.Format(Lang["registeredOn"], _doctor.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy"))
                        </div>
                    </div>
                </div>

                <button type="button" class="ld-btn ld-btn-primary pp-wide" @onclick="StartEdit">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Style="font-size:16px;" /> @Lang["Edit profile"]
                </button>
            </div>
        </div>

        @* Where the doctor lives, from their account *@
        <div class="ld-card">
            <div class="pp-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.Home" Style="font-size:19px;" /> @Lang["Where they live"]
            </div>
            <div class="ld-card-body dd-address">
                <div><span class="ld-muted">@Lang["Country"]</span> @(Locations.FindCountry(_account?.Country)?.Name(Lang.CurrentLanguage) ?? Lang["Not provided"])</div>
                <div><span class="ld-muted">@Lang["Province / state"]</span> @(_account?.Province ?? "—")</div>
                <div><span class="ld-muted">@Lang["Town / city"]</span> @(_account?.City ?? "—")</div>
                <div><span class="ld-muted">@Lang["Postal code"]</span> @(_account?.PostalCode ?? "—")</div>
            </div>
        </div>

        @* What the doctor sent to be verified; only admins (and the doctor) can open these *@
        <div class="ld-card">
            <div class="pp-card-head">
                <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Style="font-size:19px;" /> @Lang["Verification documents"]
            </div>
            <div class="ld-card-body">
                @if (_documents is null)
                {
                    <div class="ld-field-error">@Lang["The documents couldn't be loaded. Please try again in a minute."]</div>
                }
                else
                {
                    @foreach (var k in VerificationDocumentKinds.All)
                    {
                        var kind = k;
                        var docs = _documents.Where(d => d.Kind == kind).ToList();
                        <div class="dd-doc">
                            <div class="dd-doc-kind">
                                @Lang[$"vdKind.{kind}"]
                                @if (docs.Count == 0)
                                {
                                    <span class="status-pill @(VerificationDocumentKinds.Required.Contains(kind) ? "status-failed" : "status-cancelled")">@Lang["Missing"]</span>
                                }
                            </div>
                            @foreach (var d in docs)
                            {
                                var doc = d;
                                <button type="button" class="dd-doc-file" @onclick="@(() => OpenDocument(doc))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" Style="font-size:16px;" />
                                    @doc.FileName
                                    <span class="ld-muted">@doc.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }   // doctor profile id (not the account id)
    [Inject] private IAdminApiClient Admin { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDocumentApiClient DocumentsApi { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool _loading = true;
    private List<VerificationDocumentDto>? _documents = [];   // null when the Document service didn't answer

    private List<string> MissingDocuments => _documents is null ? []
        : VerificationDocumentKinds.Required.Where(k => _documents.All(d => d.Kind != k)).ToList();
    private DoctorProfileDto? _doctor;   // the profile as saved
    private UserDto? _account;           // the doctor's account: email and phone (null if Identity didn't answer)
    private List<ClinicDto> _clinics = [];

    // Edit form (filled from the saved profile when editing starts)
    private bool _editing;
    private bool _submitted;
    private bool _busy;
    private string? _error;
    private string _firstName = "";
    private string _lastName = "";
    private string _specialty = "";
    private string? _licenseNumber;
    private string? _phone;
    private string? _bio;
    private decimal _consultationFee;
    private IReadOnlyCollection<Guid> _clinicIds = [];

    // The usual list, plus the doctor's current specialty if it was typed in before the list existed
    private IEnumerable<string> SpecialtyOptions =>
        Specialties.All.Contains(_specialty) || Blank(_specialty) ? Specialties.All : Specialties.All.Prepend(_specialty);

    protected override async Task OnInitializedAsync()
    {
        var clinicsTask = Admin.GetClinicsAsync();
        _doctor = await Admin.GetDoctorAsync(Id);
        _clinics = await clinicsTask;
        if (_doctor is not null)
        {
            await LoadAccountAsync();
            try { _documents = await DocumentsApi.GetVerificationDocumentsForDoctorAsync(_doctor.UserId); }
            catch (Exception) { _documents = null; }
        }
        _loading = false;
    }

    private async Task OpenDocument(VerificationDocumentDto doc)
    {
        var url = await DocumentsApi.GetVerificationDocumentUrlAsync(doc.Id);
        if (url is not null) Navigation.NavigateTo(url, forceLoad: true);
        else Snackbar.Add(Lang["This document couldn't be opened. Please try again."], Severity.Error);
    }

    private async Task LoadAccountAsync()
    {
        try { _account = await Identity.GetUserAsAdminAsync(_doctor!.UserId); }
        catch (Exception) { _account = null; } // the card just shows "—" for email and phone
    }

    private void StartEdit()
    {
        if (_doctor is null) return;
        _firstName = _doctor.FirstName;
        _lastName = _doctor.LastName;
        _specialty = _doctor.Specialty;
        _licenseNumber = _doctor.LicenseNumber;
        _phone = _account?.Phone;
        _bio = _doctor.Bio;
        _consultationFee = _doctor.ConsultationFee;
        _clinicIds = _doctor.Clinics.Select(c => c.Id).ToList();
        _submitted = false;
        _error = null;
        _editing = true;
    }

    private void CancelEdit() => _editing = false;

    // Account first (it refuses a name or phone someone else already uses), then the profile,
    // so a refused name never leaves the two halves disagreeing.
    private async Task Save()
    {
        _submitted = true;
        _error = null;
        if (Blank(_firstName) || Blank(_lastName) || Blank(_specialty) || _consultationFee < 0)
        {
            _error = Lang["Please fill in the highlighted fields."];
            return;
        }

        _busy = true;
        try
        {
            if (_account is not null)
            {
                var accountResp = await Identity.UpdateUserAsAdminAsync(_doctor!.UserId,
                    new UpdateMeRequest(_firstName.Trim(), _lastName.Trim(), Blank(_phone) ? null : _phone!.Trim()));
                var duplicate = await DuplicateAccountMessages.ForAsync(accountResp, Lang, isDoctor: true);
                if (duplicate is not null || !accountResp.IsSuccessStatusCode)
                {
                    _error = duplicate ?? Lang["Could not save the profile. Please try again."];
                    return;
                }
            }

            // Empty strings (not null) for bio and licence so clearing them is saved too
            var profileResp = await Admin.UpdateDoctorAsync(_doctor!.Id, new UpdateOwnDoctorProfileRequest(
                _bio ?? "", _clinicIds.ToList(), _consultationFee,
                _firstName.Trim(), _lastName.Trim(), _specialty, _licenseNumber ?? ""));
            var profileDuplicate = await DuplicateAccountMessages.ForAsync(profileResp, Lang, isDoctor: true);

            if (profileDuplicate is not null)
            {
                _error = profileDuplicate;
            }
            else if (profileResp.IsSuccessStatusCode)
            {
                _doctor = await Admin.GetDoctorAsync(Id) ?? _doctor;
                await LoadAccountAsync();
                _editing = false;
                Snackbar.Add(Lang["Profile saved."], Severity.Success);
            }
            else
            {
                _error = Lang["Could not save the profile. Please try again."];
            }
        }
        catch (Exception)
        {
            _error = Lang["Could not save the profile. Please try again."];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Approve()
    {
        _busy = true;
        await Admin.ApproveDoctorAsync(Id);
        _doctor = await Admin.GetDoctorAsync(Id) ?? _doctor;
        _busy = false;
    }

    private async Task Suspend()
    {
        _busy = true;
        await Admin.SuspendDoctorAsync(Id, new SuspendDoctorRequest(null));
        _doctor = await Admin.GetDoctorAsync(Id) ?? _doctor;
        _busy = false;
    }

    // Approved green, pending amber, suspended/rejected red
    private static string StatusPill(DoctorApprovalStatus status) => status switch
    {
        DoctorApprovalStatus.Approved => "status-confirmed",
        DoctorApprovalStatus.Pending => "status-pending",
        _ => "status-failed",
    };

    // MudSelect shows selected values with this; without it, a picked clinic appears as its id
    private string ClinicName(Guid id) => _clinics.FirstOrDefault(c => c.Id == id)?.Name ?? "";

    private static bool Blank(string? value) => string.IsNullOrWhiteSpace(value);
}
