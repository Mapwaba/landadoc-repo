@page "/clinics"
@attribute [Authorize(Roles = "Admin")]

@* Clinics doctors can say they work at. The same form adds a clinic and edits one (_editingId
   says which). Switching one off takes it out of the lists doctors pick from, but doctors who
   already work there keep it. Deleting a clinic no doctor works at removes it; one with doctors
   is switched off instead. *@

<PageTitle>Clinics</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Lang["Clinics"]</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4" OnClick="ToggleCreateForm">
    @(_showForm && _editingId is null ? Lang["Cancel"] : Lang["Add clinic"])
</MudButton>

@if (_showForm)
{
    <MudPaper Class="pa-6 mb-6">
        <MudText Typo="Typo.h6" Class="mb-3">@(_editingId is null ? Lang["New clinic"] : Lang["Edit clinic"])</MudText>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="@Lang["Name"]" @bind-Value="_name" Required="true" Class="mb-3" />
            <MudSelect T="ClinicType" Label="@Lang["Type"]" @bind-Value="_type" Class="mb-3">
                @foreach (var type in Enum.GetValues<ClinicType>())
                {
                    <MudSelectItem T="ClinicType" Value="@type">@Lang[$"clinicType.{type}"]</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="@Lang["Address"]" @bind-Value="_address" Class="mb-3" />
            <MudTextField T="string" Label="@Lang["City"]" @bind-Value="_city" Required="true" Class="mb-3" />
            <MudTextField T="string" Label="@Lang["Phone"]" @bind-Value="_phone" Class="mb-3" />
            @if (_editingId is not null)
            {
                <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Primary" Label="@Lang["Offered to doctors"]" Class="mb-3" />
            }

            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_formError</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">
                @(_editingId is null ? Lang["Create"] : Lang["Save"])
            </MudButton>
            <MudButton Variant="Variant.Text" Class="ml-2" OnClick="CloseForm">@Lang["Cancel"]</MudButton>
        </MudForm>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_loadFailed)
{
    <MudAlert Severity="Severity.Warning">@Lang["Clinics couldn't be loaded. Please try again in a minute."]</MudAlert>
}
else
{
    <MudTable Items="_clinics" Hover="true">
        <HeaderContent>
            <MudTh>@Lang["Name"]</MudTh>
            <MudTh>@Lang["Type"]</MudTh>
            <MudTh>@Lang["City"]</MudTh>
            <MudTh>@Lang["Address"]</MudTh>
            <MudTh>@Lang["Phone"]</MudTh>
            <MudTh>@Lang["Status"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@Lang[$"clinicType.{context.Type}"]</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd>@(context.Address ?? "—")</MudTd>
            <MudTd>@(context.Phone ?? "—")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? Lang["Active"] : Lang["Inactive"])
                </MudChip>
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap;">
                <MudTooltip Text="@Lang["Edit"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                   aria-label="@Lang["Edit"]" OnClick="@(() => Edit(context))" />
                </MudTooltip>
                <MudTooltip Text="@Lang["Delete"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                   aria-label="@Lang["Delete"]" Disabled="@(_deletingId == context.Id)" OnClick="@(() => Delete(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Inject] private IAdminApiClient Admin { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;
    [Inject] private IDialogService Dialogs { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private bool _loading = true;
    private bool _loadFailed;
    private List<ClinicDto> _clinics = [];

    private bool _showForm;
    private Guid? _editingId;   // null while adding a new clinic
    private MudForm _form = default!;
    private string _name = "";
    private ClinicType _type = ClinicType.PrivatePractice;
    private string? _address;
    private string _city = "";
    private string? _phone;
    private bool _isActive = true;
    private bool _saving;
    private string? _formError;

    private Guid? _deletingId;   // the clinic being deleted, its button disabled meanwhile

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _clinics = await Admin.GetClinicsAsync();
        }
        catch (Exception)
        {
            _loadFailed = true;
        }
        _loading = false;
    }

    // "Add clinic" opens an empty form; pressing it again while adding closes it
    private void ToggleCreateForm()
    {
        if (_showForm && _editingId is null)
        {
            CloseForm();
            return;
        }
        Fill(null, "", ClinicType.PrivatePractice, null, "", null, true);
    }

    private void Edit(ClinicDto clinic) =>
        Fill(clinic.Id, clinic.Name, clinic.Type, clinic.Address, clinic.City, clinic.Phone, clinic.IsActive);

    // Put values into the form and show it (id = null means a new clinic)
    private void Fill(Guid? id, string name, ClinicType type, string? address, string city, string? phone, bool isActive)
    {
        _editingId = id;
        _name = name;
        _type = type;
        _address = address;
        _city = city;
        _phone = phone;
        _isActive = isActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _editingId = null;
        _formError = null;
    }

    private async Task Save()
    {
        _formError = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            // An emptied address or phone is sent as "" so the server clears it (null means "unchanged")
            var resp = _editingId is null
                ? await Admin.CreateClinicAsync(new CreateClinicRequest(
                    _name.Trim(), _type, Blank(_address), _city.Trim(), Blank(_phone)))
                : await Admin.UpdateClinicAsync(_editingId.Value, new UpdateClinicRequest(
                    _name.Trim(), _type, _address?.Trim() ?? "", _city.Trim(), _phone?.Trim() ?? "", _isActive));

            if (resp.IsSuccessStatusCode)
            {
                CloseForm();
                await Load();
            }
            else
            {
                _formError = Lang["Could not save the clinic."];
            }
        }
        catch (Exception)
        {
            _formError = Lang["Could not save the clinic."];
        }
        _saving = false;
    }

    // Asks first; a clinic doctors work at is switched off instead of deleted
    private async Task Delete(ClinicDto clinic)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            Lang["Delete clinic"],
            string.Format(Lang["deleteClinicQuestion"], clinic.Name),
            yesText: Lang["Delete"], cancelText: Lang["Cancel"]);
        if (confirmed != true) return;

        _deletingId = clinic.Id;
        try
        {
            var resp = await Admin.DeleteClinicAsync(clinic.Id);
            if (resp.StatusCode == System.Net.HttpStatusCode.OK)
            {
                if (_editingId == clinic.Id) CloseForm();
                Snackbar.Add(string.Format(Lang["clinicSwitchedOff"], clinic.Name), Severity.Info);
                await Load();
            }
            else if (resp.IsSuccessStatusCode || resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                if (_editingId == clinic.Id) CloseForm();
                Snackbar.Add(string.Format(Lang["clinicDeleted"], clinic.Name), Severity.Success);
                await Load();
            }
            else
            {
                Snackbar.Add(Lang["Could not delete the clinic. Please try again."], Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Lang["Could not delete the clinic. Please try again."], Severity.Error);
        }
        _deletingId = null;
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
