@page "/doctors/{DoctorId:guid}"
@using System.Globalization

@* A doctor's public profile, opened from "View profile" in the search results. Laid out like the
   doctor's own agenda (Doctor/Pages/Appointments.razor): a month calendar showing how many times
   are open each day, a side panel with the chosen day's times, and booking right there.
   Anyone can view it; booking needs a patient account. *@

<PageTitle>Doctor profile</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_doctor is null)
{
    <MudAlert Severity="Severity.Error">@Lang["Doctor not found."]</MudAlert>
}
else
{
    @* Who the doctor is *@
    <div class="profile-card">
        <div class="profile-avatar">
            @if (_doctor.PhotoDataUrl is { } photo)
            {
                <img class="ld-photo-img" src="@photo" alt="" />
            }
            else
            {
                @Initials
            }
        </div>
        <div class="profile-main">
            <h2 class="profile-name">@Lang["Dr."] @_doctor.FirstName @_doctor.LastName</h2>
            <div class="profile-specialty">@Lang[_doctor.Specialty]</div>
            @if (_doctor.Clinics.Count > 0)
            {
                <div class="profile-clinics">
                    @foreach (var clinic in _doctor.Clinics)
                    {
                        <span class="profile-clinic">
                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Style="font-size:14px;" /> @clinic.Name — @clinic.City
                        </span>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_doctor.Bio))
            {
                <p class="profile-bio">@_doctor.Bio</p>
            }
        </div>
        <div class="profile-facts">
            <div class="profile-rating">
                <MudRating SelectedValue="@((int)Math.Round(_doctor.AverageRating))" ReadOnly="true" Size="Size.Small" />
                <span>(@string.Format(Lang["reviewCount"], _doctor.RatingCount, _doctor.RatingCount == 1 ? "" : "s"))</span>
            </div>
            <div class="profile-fee">@string.Format(Lang["perConsultation"], _doctor.ConsultationFee.ToString("0.00"))</div>
        </div>
    </div>

    @* Toolbar: month title with previous / today / next *@
    <div class="agenda-toolbar">
        <div class="agenda-toolbar-left">
            <h2 class="agenda-title">@MonthTitle</h2>
            <div class="agenda-nav">
                <button type="button" class="agenda-nav-btn" @onclick="PreviousMonth" disabled="@(_month <= ThisMonth)" aria-label="Previous month">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small" />
                </button>
                <button type="button" class="agenda-nav-today" @onclick="GoToToday">@Lang["Today"]</button>
                <button type="button" class="agenda-nav-btn" @onclick="NextMonth" aria-label="Next month">
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                </button>
            </div>
        </div>
    </div>

    <div class="agenda-layout">
        @* Month grid, weeks starting on Monday; each upcoming day shows how many slots are open *@
        <div class="agenda-calendar">
            <div class="agenda-weekdays">
                @foreach (var name in WeekdayHeaders)
                {
                    <div>@name</div>
                }
            </div>
            <div class="agenda-grid">
                @foreach (var day in CalendarDays)
                {
                    var date = day;   // copy for the click handler below
                    var past = date < Today;
                    _openCounts.TryGetValue(date, out var count);
                    <div class="agenda-day @(date.Month != _month.Month ? "other-month" : "") @(past ? "past" : "") @(date == _selected ? "selected" : "")"
                         @onclick="@(() => SelectDay(date))">
                        <div class="agenda-day-head">
                            <span class="agenda-day-number @(date == Today ? "today" : "")">@date.Day</span>
                        </div>
                        @if (!past && count > 0)
                        {
                            <div class="agenda-chip">@SlotCountLabel(count)</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="agenda-side">
            @* Open times for the selected day *@
            <div class="side-card">
                <div class="side-card-title">
                    <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" /> @SelectedTitle</span>
                </div>
                <div class="side-card-body">
                    @if (_selected < Today)
                    {
                        <div class="side-empty">@Lang["This day has passed."]</div>
                    }
                    else if (_loadingSlots)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_slotsFailed)
                    {
                        <div class="side-empty">@Lang["Slots are unavailable right now."]</div>
                    }
                    else
                    {
                        <div class="slot-label">@Lang["Available times"]</div>
                        @if (_slots.Count == 0)
                        {
                            <div class="side-empty">@Lang["No open slots this day."]</div>
                        }
                        else
                        {
                            @if (SlotTimes.Note(_selected, _slots, _slotZone, Lang) is { } zoneNote)
                            {
                                <div class="slot-zone-note">@zoneNote</div>
                            }
                            <div class="slot-grid">
                                @foreach (var slot in _slots)
                                {
                                    var s = slot;
                                    <button type="button" class="slot slot-open @(s == _selectedSlot ? "chosen" : "")" @onclick="@(() => _selectedSlot = s)">
                                        @s
                                        @if (SlotTimes.ForViewer(_selected, s, _slotZone, Lang.CurrentLanguage) is { } yours)
                                        {
                                            <span class="slot-yours">@yours</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* Booking: who it's for, why, and confirm *@
            <div class="side-card">
                <div class="side-card-title side-card-title-tinted">
                    <span><MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" /> @Lang["Your appointment"]</span>
                </div>
                <div class="side-card-body">
                    @if (_selectedSlot is null)
                    {
                        <div class="side-empty">@Lang["Pick a day on the calendar, then a time."]</div>
                    }
                    else
                    {
                        <div class="booking-summary">
                            <div class="booking-time">@SlotTimes.Label(_selected, _selectedSlot, _slotZone, Lang)</div>
                            <div class="booking-date">@SelectedTitle</div>
                        </div>
                    }

                    @* Visitors are sent to log in (and brought back here); doctors and admins can't book *@
                    @if (!_isAuthenticated)
                    {
                        <a class="booking-button" href="@LoginHref">@Lang["Log in to book"]</a>
                    }
                    else if (!_isPatient)
                    {
                        <div class="side-empty">@Lang["Only patient accounts can book appointments."]</div>
                    }
                    else
                    {
                        <MudSelect T="Guid?" Label="@Lang["Booking for"]" @bind-Value="_bookForPatientId" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var option in _bookForOptions)
                            {
                                <MudSelectItem T="Guid?" Value="@option.Id">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField T="string" Label="@Lang["Reason for visit (optional)"]" @bind-Value="_motif" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />

                        @if (_error is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                        }

                        <button type="button" class="booking-button" disabled="@(_selectedSlot is null || _submitting)" @onclick="Confirm">
                            @Lang["Confirm booking"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    @* What other patients said *@
    <div class="reviews-card">
        <div class="side-card-title">
            <span><MudIcon Icon="@Icons.Material.Outlined.StarOutline" Size="Size.Small" /> @Lang["Reviews"]</span>
        </div>
        <div class="side-card-body">
            @if (_reviews.Count == 0)
            {
                <div class="side-empty">@Lang["No reviews yet."]</div>
            }
            @foreach (var review in _reviews)
            {
                <div class="review">
                    <div class="review-top">
                        <MudRating SelectedValue="review.Rating" ReadOnly="true" Size="Size.Small" />
                        <span class="review-date">@review.CreatedAt.ToLocalTime().ToString("d", Culture)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <div class="review-comment">@review.Comment</div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid DoctorId { get; set; }
    [Inject] private ISearchApiClient Search { get; set; } = default!;
    [Inject] private IReviewApiClient Reviews { get; set; } = default!;
    [Inject] private IAvailabilityApiClient Availability { get; set; } = default!;
    [Inject] private IAppointmentApiClient Appointments { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    // The doctor and their reviews
    private bool _loading = true;
    private DoctorSearchResultDto? _doctor;
    private List<ReviewDto> _reviews = [];

    // Calendar

    private DateOnly _month;      // first day of the month on screen
    private DateOnly _selected;   // day shown in the right-hand panel
    private Dictionary<DateOnly, int> _openCounts = [];   // open times per day, filled in as answers arrive
    private int _monthVersion;    // drops counts from a month the patient has already left
    private bool _patientMoved;   // the patient picked a day or changed month — stop choosing for them

    // Times for the selected day, and the one the patient picked ("HH:mm")
    private bool _loadingSlots;
    private bool _slotsFailed;
    private List<string> _slots = [];
    private string? _slotZone;   // the doctor's clock the times are on, e.g. "Africa/Kinshasa"
    private string? _selectedSlot;

    // Booking form
    private bool _isAuthenticated;
    private bool _isPatient;
    private List<(Guid? Id, string Label)> _bookForOptions = [];   // "Myself" (null id) plus family members and dependants
    private Guid? _bookForPatientId;
    private string? _motif;
    private bool _submitting;
    private string? _error;

    // Slots are clinic clock times (no time zone conversion in the backend), so days are
    // compared as plain dates, the same way the doctor's agenda does it.
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private static DateOnly ThisMonth => new(Today.Year, Today.Month, 1);
    private CultureInfo Culture => CultureInfo.GetCultureInfo(Lang.CurrentLanguage == "fr" ? "fr-FR" : "en-US");

    protected override async Task OnInitializedAsync()
    {
        _selected = Today;
        _month = ThisMonth;

        // Fetch the doctor and the reviews at the same time
        var doctorTask = Search.GetDoctorAsync(DoctorId);
        var reviewsTask = Reviews.GetForDoctorAsync(DoctorId);
        _doctor = await doctorTask;
        _reviews = (await reviewsTask).ToList();

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _isPatient = user.IsInRole("Patient");

        // A patient can book for themselves or for anyone in their family they're allowed to book for
        if (_isPatient)
        {
            _bookForOptions = [(null, Lang["Myself"])];
            var family = await Identity.GetMyFamilyAsync();
            if (family is not null)
            {
                _bookForOptions.AddRange(family.Family.Select(f => ((Guid?)f.UserId, $"{f.FirstName} {f.LastName} ({f.RelationLabel})")));
                _bookForOptions.AddRange(family.Dependents.Select(d => ((Guid?)d.Id, $"{d.FirstName} {d.LastName} ({d.RelationLabel})")));
            }
        }
        _loading = false;

        if (_doctor is null) return;
        await LoadSlotsAsync();             // today's times first, so the panel fills quickly
        _ = OpenOnFirstOpenDayAsync();      // then the calendar counts, in the background
    }

    // Today often has no open times (a day off, or the day's slots are over), which reads as
    // "this doctor has no availability". Open on the first upcoming day that has times
    // instead, looking at this month and then the next.
    private async Task OpenOnFirstOpenDayAsync()
    {
        for (var monthsAhead = 0; monthsAhead < 2; monthsAhead++)
        {
            await LoadMonthCountsAsync();
            if (_patientMoved || _slots.Count > 0) return;

            var firstOpen = CalendarDays.Where(d => d >= Today).FirstOrDefault(d => _openCounts.GetValueOrDefault(d) > 0);
            if (firstOpen != default)
            {
                await ShowDay(firstOpen);
                StateHasChanged(); // not started by a click, so Blazor won't re-render on its own
                return;
            }
            _month = _month.AddMonths(1);
        }
        _month = ThisMonth; // nothing open in the next two months — stay on today
        StateHasChanged();
    }

    // The patient clicked a day (or "Today")
    private Task SelectDay(DateOnly date)
    {
        _patientMoved = true;
        return ShowDay(date);
    }

    // Show a day's times in the side panel, switching the calendar to its month if needed
    private async Task ShowDay(DateOnly date)
    {
        _selected = date;
        if (date.Month != _month.Month || date.Year != _month.Year)
        {
            _month = new DateOnly(date.Year, date.Month, 1);
            _ = LoadMonthCountsAsync();
        }
        await LoadSlotsAsync();
    }

    // Month arrows only move the calendar; the selected day stays as it is.
    // There's no going back before the current month — those days are all past.
    private void PreviousMonth()
    {
        if (_month <= ThisMonth) return;
        _patientMoved = true;
        _month = _month.AddMonths(-1);
        _ = LoadMonthCountsAsync();
    }

    private void NextMonth()
    {
        _patientMoved = true;
        _month = _month.AddMonths(1);
        _ = LoadMonthCountsAsync();
    }

    private Task GoToToday() => SelectDay(Today);

    // Load the selected day's open times into the side panel. Picking another day clears
    // the chosen time, so a booking can never go out for a day the patient isn't looking at.
    private async Task LoadSlotsAsync()
    {
        _selectedSlot = null;
        _error = null;
        _slots = [];
        _slotsFailed = false;
        if (_selected < Today) return;

        _loadingSlots = true;
        StateHasChanged();
        try
        {
            var day = _selected;
            var list = await Availability.GetSlotListAsync(DoctorId, day);
            if (day != _selected) return;   // the patient clicked another day meanwhile
            _slots = list.Slots;
            _slotZone = list.TimeZone;
            _openCounts[day] = _slots.Count;   // keep the calendar tag in step with what we just saw
        }
        catch (Exception)
        {
            _slotsFailed = true;
        }
        _loadingSlots = false;
    }

    // There's no public weekly schedule, so ask for each upcoming day's slots on the grid
    // in parallel and show the counts as they arrive. Failed days just show nothing.
    private async Task LoadMonthCountsAsync()
    {
        var version = ++_monthVersion;
        // Past days can't be booked, and days already counted don't need asking again
        var days = CalendarDays.Where(d => d >= Today && !_openCounts.ContainsKey(d)).ToList();

        await Task.WhenAll(days.Select(async day =>
        {
            try
            {
                var slots = await Availability.GetSlotsAsync(DoctorId, day);
                if (version != _monthVersion) return;
                _openCounts[day] = slots.Count;
                StateHasChanged();
            }
            catch (Exception)
            {
                // one day failing shouldn't stop the others; that day simply shows no tag
            }
        }));
    }

    // Create the appointment for the chosen time, then open it — that's where the patient pays.
    private async Task Confirm()
    {
        if (_selectedSlot is null) return;

        _error = null;
        _submitting = true;

        // Availability computes slots against UTC day boundaries with bare wall-clock
        // times (no timezone conversion anywhere in the backend) — match that here so
        // the booked slot lines up with what was actually offered.
        var time = TimeOnly.Parse(_selectedSlot);
        var slotStart = DateTime.SpecifyKind(_selected.ToDateTime(time), DateTimeKind.Utc);

        var resp = await Appointments.CreateAsync(new CreateAppointmentRequest(DoctorId, slotStart, _motif, _bookForPatientId));
        _submitting = false;

        if (resp.IsSuccessStatusCode)
        {
            var appt = await resp.Content.ReadFromJsonAsync<AppointmentDto>(JsonDefaults.Options);
            Navigation.NavigateTo($"/appointments/{appt!.Id}");
        }
        else if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // Someone else booked it first: refresh the times so the taken one disappears
            await LoadSlotsAsync();
            _error = Lang["That slot was just taken. Please pick another time."];
        }
        else if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // The family link was revoked since the page loaded
            _error = Lang["You're no longer authorized to book for that person."];
        }
        else
        {
            _error = Lang["Booking failed. Please try again."];
        }
    }

    // Login brings the patient back to this doctor afterwards
    private string LoginHref => $"/login?returnUrl={Uri.EscapeDataString($"/doctors/{DoctorId}")}";

    private string Initials =>
        $"{_doctor?.FirstName.FirstOrDefault()}{_doctor?.LastName.FirstOrDefault()}".ToUpperInvariant();

    // "1 open slot" / "5 open slots"
    private string SlotCountLabel(int count) =>
        count == 1 ? Lang["oneOpenSlot"] : string.Format(Lang["manyOpenSlots"], count);

    // Monday-first weeks covering the whole month (4 to 6 rows): starts on the Monday on or
    // before the 1st and ends on the Sunday on or after the last day, so the grid is always full weeks.
    private IEnumerable<DateOnly> CalendarDays
    {
        get
        {
            var start = _month.AddDays(-(((int)_month.DayOfWeek + 6) % 7));
            var end = _month.AddMonths(1).AddDays(-1);
            end = end.AddDays((7 - ((int)end.DayOfWeek + 6) % 7 - 1) % 7);
            for (var d = start; d <= end; d = d.AddDays(1))
                yield return d;
        }
    }

    // "MON".."SUN" (or "LUN".."DIM") in the current language
    private IEnumerable<string> WeekdayHeaders =>
        Enumerable.Range(0, 7)
            .Select(i => Culture.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)((i + 1) % 7)))
            .Select(n => n.TrimEnd('.').ToUpper(Culture));

    // "October 2026" / "Octobre 2026"
    private string MonthTitle => Capitalize(_month.ToDateTime(TimeOnly.MinValue).ToString("MMMM yyyy", Culture));

    // "Friday, October 9" / "Vendredi 9 Octobre"
    private string SelectedTitle => Culture.TextInfo.ToTitleCase(
        _selected.ToDateTime(TimeOnly.MinValue).ToString(Lang.CurrentLanguage == "fr" ? "dddd d MMMM" : "dddd, MMMM d", Culture));

    private string Capitalize(string s) => s.Length == 0 ? s : char.ToUpper(s[0], Culture) + s[1..];
}
