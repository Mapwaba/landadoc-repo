@page "/book/{DoctorId:guid}"
@attribute [Authorize(Roles = "Patient")]

<PageTitle>Book appointment</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Lang["Book an appointment"]</MudText>

@if (_doctor is not null)
{
    <MudText Typo="Typo.h6" Class="mb-4">
        @string.Format(Lang["withDoctorSummary"], $"{Lang["Dr."]} {_doctor.FirstName} {_doctor.LastName}", _doctor.Specialty, _doctor.ConsultationFee.ToString("0.00"))
    </MudText>
}

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="Guid?" Label="@Lang["Booking for"]" @bind-Value="_bookForPatientId">
            @foreach (var option in _bookForOptions)
            {
                <MudSelectItem T="Guid?" Value="@option.Id">@option.Label</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudDatePicker Label="@Lang["Date"]" @bind-Date="_date" MinDate="DateTime.Today" @bind-Date:after="LoadSlots" />
    </MudItem>
</MudGrid>

@if (_loadingSlots)
{
    <MudProgressCircular Indeterminate="true" Class="mt-4" />
}
else if (_date is not null)
{
    @if (_selectedSlot is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">
            @string.Format(Lang["selectedSlotFor"], _date.Value.ToString("dd/MM/yyyy")) <b>@_selectedSlot</b>
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="ml-2" OnClick="ClearSelection">@Lang["Change"]</MudButton>
        </MudAlert>
    }
    else if (_slots.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">@Lang["No open slots on this date."]</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">
            @string.Format(Lang["availableSlotsFor"], _date.Value.ToString("dd/MM/yyyy"))
        </MudText>
        @foreach (var slot in _slots)
        {
            <MudChip T="string" Class="mr-1 mb-1" OnClick="@(() => SelectSlot(slot))">@slot</MudChip>
        }
    }
}

<MudTextField T="string" Label="@Lang["Reason for visit (optional)"]" @bind-Value="_motif" Lines="2" Class="mt-4" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
           Disabled="@(_selectedSlot is null || _submitting)" OnClick="Confirm">
    @Lang["Confirm booking"]
</MudButton>

@code {
    [Parameter] public Guid DoctorId { get; set; }
    [Inject] private ISearchApiClient Search { get; set; } = default!;
    [Inject] private IAvailabilityApiClient Availability { get; set; } = default!;
    [Inject] private IAppointmentApiClient Appointments { get; set; } = default!;
    [Inject] private IIdentityApiClient Identity { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ILanguageService Lang { get; set; } = default!;

    private DoctorSearchResultDto? _doctor;
    private DateTime? _date;
    private bool _loadingSlots;
    private List<string> _slots = [];
    private string? _selectedSlot;
    private string? _motif;
    private bool _submitting;
    private string? _error;
    private List<(Guid? Id, string Label)> _bookForOptions = [];
    private Guid? _bookForPatientId;

    protected override async Task OnInitializedAsync()
    {
        _doctor = await Search.GetDoctorAsync(DoctorId);

        _bookForOptions = [(null, Lang["Myself"])];
        var family = await Identity.GetMyFamilyAsync();
        if (family is not null)
        {
            _bookForOptions.AddRange(family.Family.Select(f => ((Guid?)f.UserId, $"{f.FirstName} {f.LastName} ({f.RelationLabel})")));
            _bookForOptions.AddRange(family.Dependents.Select(d => ((Guid?)d.Id, $"{d.FirstName} {d.LastName} ({d.RelationLabel})")));
        }

        _date = DateTime.Today;
        await LoadSlots();
    }

    private async Task LoadSlots()
    {
        _selectedSlot = null;
        if (_date is null) return;

        _loadingSlots = true;
        _slots = await Availability.GetSlotsAsync(DoctorId, DateOnly.FromDateTime(_date.Value));
        _loadingSlots = false;
    }

    private void SelectSlot(string slot)
    {
        _selectedSlot = slot;
        _slots.Remove(slot);
    }

    private void ClearSelection()
    {
        if (_selectedSlot is null) return;
        _slots.Add(_selectedSlot);
        _slots.Sort();
        _selectedSlot = null;
    }

    private async Task Confirm()
    {
        if (_date is null || _selectedSlot is null) return;

        _error = null;
        _submitting = true;

        // Availability computes slots against UTC day boundaries with bare wall-clock
        // times (no timezone conversion anywhere in the backend) — match that here so
        // the booked slot lines up with what was actually offered.
        var time = TimeOnly.Parse(_selectedSlot);
        var slotStart = DateTime.SpecifyKind(_date.Value.Date.Add(time.ToTimeSpan()), DateTimeKind.Utc);

        var resp = await Appointments.CreateAsync(new CreateAppointmentRequest(DoctorId, slotStart, _motif, _bookForPatientId));
        _submitting = false;

        if (resp.IsSuccessStatusCode)
        {
            var appt = await resp.Content.ReadFromJsonAsync<AppointmentDto>(JsonDefaults.Options);
            Navigation.NavigateTo($"/appointments/{appt!.Id}");
        }
        else if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _error = Lang["That slot was just taken. Please pick another time."];
            await LoadSlots();
        }
        else if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _error = Lang["You're no longer authorized to book for that person."];
        }
        else
        {
            _error = Lang["Booking failed. Please try again."];
        }
    }
}
